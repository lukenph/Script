        hip=(128.0, 134.0 + tt * 0.3), sh=(196.0, 140.0 + tt * 0.3), arch=30.0,
        head=(238.0, 152.0 + tt * 0.4), rot=-8.0, look=(2.0, 3.0),
        eye=0.0, anger=0.0, mouth=0.0, ear=0.25,
