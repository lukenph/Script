VAPOR_FPS = 16


class _Seg:
    """Um trecho da rotina do gato: oculto, andando, tocando um clipe ou parado no último quadro."""
    __slots__ = ("tipo", "dur", "clip", "x0", "x1", "curva", "rep", "grr")

    def __init__(self, tipo, dur, clip=None, x0=0.0, x1=0.0, curva="linear", rep=1, grr=False):
        self.tipo, self.dur, self.clip = tipo, dur, clip
        self.x0, self.x1, self.curva, self.rep, self.grr = x0, x1, curva, rep, grr


def _curva(nome: str, u: float) -> float:
    u = max(0.0, min(1.0, u))
    if nome == "saida":       # chega rápido e vai freando até parar
        return 1.0 - (1.0 - u) ** 1.7
    if nome == "entrada":     # sai devagar e vai acelerando
        return u ** 1.6
    return u


class Cena(tk.Canvas):
    """Fundo da janela: parede, balcão, xícara com fumaça e o Hunter Cat.

    Todos os desenhos são criados uma vez (PIL, com suavização) e o Tk só troca quadros e move
    itens; a posição vem do relógio (não de passos fixos), então o movimento fica liso mesmo
    quando um quadro demora mais.
    """

    VEL_CHEGADA = 150.0   # velocidade média ao chegar (unidades do sprite por segundo)
    VEL_SAIDA = 175.0     # velocidade média ao ir embora

    def __init__(self, master, esc: float):
        super().__init__(master, bg=T.PAREDE_BASE, highlightthickness=0, bd=0)
        self.place(x=0, y=0, relwidth=1, relheight=1)
        self.esc = esc
        self.k = esc * 0.92
        self._larg = self._alt = 0
        self._geo = geometria(1200, 800, esc)
        self._tam_gato = tamanho_sprite(self.k)
        self._fotos: dict[str, Any] = {}
        self._fotos_vapor: list = []
        self._foto_gato = None
        self._quadros: dict | None = None
        self._dados: dict = {}
        self._etapa1 = threading.Event()
        self._etapa2 = threading.Event()
        self._aplicou1 = False
        self._segs: list[_Seg] = []
        self._iseg = 0
        self._t_seg = 0.0
        self._frame_atual = None
        self._x = -9999.0
        self._y_gato = 0.0
        self._gato_visivel = False
        self._grr_visivel = False
        self._i_vapor_atual = -1
        self._falhas = 0
        self._ult = time.perf_counter()
        self._after_tick = self._after_fundo = self._after_espera = None
        self._timer_alto = False

        familia_titulo = fonte(self, 10, "bold", titulo=True)[0]
        familia_corpo = fonte(self, 10)[0]
        s = esc
        self._i_fundo = self.create_image(0, 0, anchor="nw")
        self._i_logo = self.create_image(int(28 * s), int(16 * s), anchor="nw")
        self.create_text(int(112 * s), int(20 * s), anchor="nw", text="Hunter Cat", fill=T.CREME,
                         font=(familia_titulo, -int(36 * s), "bold"))
        self.create_text(int(114 * s), int(64 * s), anchor="nw", text="Seu gato caçador de alvos na tela",
                         fill=T.SUAVE, font=(familia_corpo, -int(14 * s)))
        self._i_xicara = self.create_image(0, 0, anchor="s", state="hidden")
        self._i_vapor = self.create_image(0, 0, anchor="s", state="hidden")
        self._i_gato = self.create_image(0, 0, anchor="nw", state="hidden")
        self._i_grr = self.create_text(0, 0, anchor="w", text="", fill=T.CREME, state="hidden",
                                       font=(familia_titulo, -int(24 * s), "bold italic"))

        self.bind("<Configure>", self._ao_redimensionar, add="+")
        threading.Thread(target=self._preparar, name="hunter-cat-arte", daemon=True).start()
        self._after_espera = self.after(120, self._aguardar)

    # ------------------------------------------------------------ preparo (thread)
    def _preparar(self) -> None:
        """Só PIL/numpy aqui: nada de Tk fora da thread principal."""
        try:
            self._dados["icone"] = desenhar_icone(0.62 * self.esc)
            self._dados["xicara"] = desenhar_xicara(self.k)
            self._dados["vapor"] = gerar_vapor(self.k, 48)
        except Exception as erro:
            self._dados["erro"] = erro
        finally:
            self._etapa1.set()
        try:
            def ceder(_p):
                time.sleep(0.003)      # devolve a CPU para a interface durante o preparo
            self._dados["gato"] = gerar_quadros_gato(self.k, ceder)
        except Exception as erro:
            self._dados["erro_gato"] = erro
        finally:
            self._etapa2.set()

    def _aguardar(self) -> None:
        self._after_espera = None
        try:
            if not self.winfo_exists():
                return
        except tk.TclError:
            return
        if self._etapa1.is_set() and not self._aplicou1:
            self._aplicou1 = True
            self._aplicar_etapa1()
        if self._etapa2.is_set():
            self._aplicar_etapa2()
            return
        self._after_espera = self.after(150, self._aguardar)

    def _aplicar_etapa1(self) -> None:
        if "erro" in self._dados:
            print(f"[hunter-cat] arte indisponível: {self._dados['erro']}", file=sys.stderr)
            return
        self._fotos["logo"] = ImageTk.PhotoImage(self._dados["icone"])
        self.itemconfigure(self._i_logo, image=self._fotos["logo"])
        self._fotos["xicara"] = ImageTk.PhotoImage(self._dados["xicara"])
        self.itemconfigure(self._i_xicara, image=self._fotos["xicara"], state="normal")
        quadros, tam = self._dados["vapor"]
        self._fotos_vapor = [ImageTk.PhotoImage(decodificar(q, tam)) for q in quadros]
        self.itemconfigure(self._i_vapor, image=self._fotos_vapor[0], state="normal")
        self._posicionar()
        self._timer_preciso(True)
        self._ult = time.perf_counter()
        self._after_tick = self.after(16, self._tick)

    def _aplicar_etapa2(self) -> None:
        if "erro_gato" in self._dados:
            print(f"[hunter-cat] gato indisponível: {self._dados['erro_gato']}", file=sys.stderr)
            return
        self._quadros = self._dados["gato"]
        self._foto_gato = ImageTk.PhotoImage(Image.new("RGBA", self._tam_gato, (0, 0, 0, 0)))
        self.itemconfigure(self._i_gato, image=self._foto_gato)

    # ------------------------------------------------------------ geometria
    def _ao_redimensionar(self, evento) -> None:
        if evento.widget is not self:
            return
        w, h = max(1, evento.width), max(1, evento.height)
        if (w, h) == (self._larg, self._alt):
            return
        self._larg, self._alt = w, h
        self._posicionar()
        if self._after_fundo is not None:
            self.after_cancel(self._after_fundo)
        self._after_fundo = self.after(110, self._refazer_fundo)

    def _posicionar(self) -> None:
        w, h = self._larg or 1200, self._alt or 800
        g = self._geo = geometria(w, h, self.esc)
        self.coords(self._i_xicara, g["xic_x"], g["xic_y"])
        self.coords(self._i_vapor, g["xic_x"] - 2 * self.k, g["xic_y"] - 52 * self.k)
        self._y_gato = g["pes"] - CHAO * self.k
        if self._gato_visivel:
            self.coords(self._i_gato, self._x, self._y_gato)

    def _refazer_fundo(self) -> None:
        self._after_fundo = None
        if self._larg < 50 or self._alt < 50:
            return
        try:
            self._fotos["fundo"] = ImageTk.PhotoImage(renderizar_cena(self._larg, self._alt, self.esc))
            self.itemconfigure(self._i_fundo, image=self._fotos["fundo"])
        except Exception as erro:
            print(f"[hunter-cat] fundo indisponível: {erro}", file=sys.stderr)

    # ------------------------------------------------------------ rotina do gato
    def _montar_ciclo(self) -> list[_Seg]:
        k = self.k
        largura = max(self._larg, 900)
        larg_spr = LARG * k
        dc = DC * k
        x_parada = max(24.0, largura * 0.28 - larg_spr * 0.4)
        n1 = max(2, math.ceil((x_parada + larg_spr + 20) / dc))
        n2 = max(2, math.ceil((largura - x_parada + 40) / dc))
        dur1 = n1 * dc / (self.VEL_CHEGADA * k)
        dur2 = n2 * dc / (self.VEL_SAIDA * k)

        def d(nome):
            return len(self._quadros[nome]) / FPS_CLIP

        return [
            _Seg("oculto", 2.0),
            _Seg("andar", dur1, x0=x_parada - n1 * dc, x1=x_parada, curva="saida"),
            _Seg("clip", d("parar"), "parar", x0=x_parada),
            _Seg("clip", d("rosnar_in"), "rosnar_in", x0=x_parada),
            _Seg("clip", 2 * d("rosnar"), "rosnar", x0=x_parada, rep=2, grr=True),
            _Seg("clip", d("rosnar_out"), "rosnar_out", x0=x_parada),
            _Seg("segurar", 0.35, "rosnar_out", x0=x_parada),
            _Seg("clip", d("esp1"), "esp1", x0=x_parada),
            _Seg("segurar", 0.25, "esp1", x0=x_parada),
            _Seg("clip", d("esp2"), "esp2", x0=x_parada),
            _Seg("segurar", 0.45, "esp2", x0=x_parada),
            _Seg("clip", d("partir"), "partir", x0=x_parada),
            _Seg("andar", dur2, x0=x_parada, x1=x_parada + n2 * dc, curva="entrada"),
        ]

    def _tick(self) -> None:
        self._after_tick = None
        try:
            visivel = bool(self.winfo_viewable())
        except tk.TclError:
            return
        agora = time.perf_counter()
        if not visivel:                       # minimizado: não gasta CPU
            self._ult = agora
            self._after_tick = self.after(250, self._tick)
            return
        dt = min(0.05, agora - self._ult)
        self._ult = agora
        try:
            self._passo(agora, dt)
        except tk.TclError:
            return
        except Exception as erro:             # animação nunca derruba a interface
            self._falhas += 1
            if self._falhas > 5:
                print(f"[hunter-cat] animação desligada: {erro}", file=sys.stderr)
                return
        gasto = (time.perf_counter() - agora) * 1000
        self._after_tick = self.after(max(1, int(1000 / 60 - gasto)), self._tick)

    def _passo(self, agora: float, dt: float) -> None:
        if self._fotos_vapor:
            i = int(agora * VAPOR_FPS) % len(self._fotos_vapor)
            if i != self._i_vapor_atual:
                self._i_vapor_atual = i
                self.itemconfigure(self._i_vapor, image=self._fotos_vapor[i])
        if not self._quadros or self._foto_gato is None:
            return
        if not self._segs:
            self._segs, self._iseg, self._t_seg = self._montar_ciclo(), 0, 0.0
        self._t_seg += dt
        seg = self._segs[self._iseg]
        while self._t_seg >= seg.dur:
            self._t_seg -= seg.dur
            self._iseg += 1
            if self._iseg >= len(self._segs):
                self._segs, self._iseg = self._montar_ciclo(), 0
            seg = self._segs[self._iseg]
        self._desenhar_seg(seg, self._t_seg)

    def _desenhar_seg(self, seg: _Seg, t: float) -> None:
        if seg.tipo == "oculto":
            if self._gato_visivel:
                self.itemconfigure(self._i_gato, state="hidden")
                self._gato_visivel = False
            self._mostrar_grr(None, t)
            return
        dc = DC * self.k
        if seg.tipo == "andar":
            dist = _curva(seg.curva, t / seg.dur) * (seg.x1 - seg.x0)
            x = seg.x0 + dist
            clip, idx = "andar", int(((dist / dc) % 1.0) * NW) % NW   # pernas sincronizadas com o chão
        elif seg.tipo == "segurar":
            x, clip = seg.x0, seg.clip
            idx = len(self._quadros[clip]) - 1
        else:
            x, clip = seg.x0, seg.clip
            n = len(self._quadros[clip])
            periodo = n / FPS_CLIP
            idx = min(n - 1, int(((t % periodo) / periodo) * n))
        if (clip, idx) != self._frame_atual:
            self._frame_atual = (clip, idx)
            self._foto_gato.paste(decodificar(self._quadros[clip][idx], self._tam_gato))
        if not self._gato_visivel:
            self.itemconfigure(self._i_gato, state="normal")
            self._gato_visivel = True
        if abs(x - self._x) > 0.05:
            self._x = x
            self.coords(self._i_gato, x, self._y_gato)
        self._mostrar_grr(seg, t)

    def _mostrar_grr(self, seg, t: float) -> None:
        if seg is None or not seg.grr:
            if self._grr_visivel:
                self.itemconfigure(self._i_grr, state="hidden")
                self._grr_visivel = False
            return
        env = max(0.0, min(1.0, t / 0.35, (seg.dur - t) / 0.35))
        palavra = ("grr", "grrr", "grrrr!")[int(t * 3.2) % 3]
        vibra = self.k * 1.4
        x = self._x + 298 * self.k + random.uniform(-vibra, vibra)
        y = self._y_gato + 122 * self.k + random.uniform(-vibra, vibra)
        self.coords(self._i_grr, x, y)
        self.itemconfigure(self._i_grr, text=palavra, fill=_lerp_hex(T.PAREDE_BASE, T.CREME, env),
                           state="normal")
        self._grr_visivel = True

    # ------------------------------------------------------------ ciclo de vida
    def _timer_preciso(self, ligar: bool) -> None:
        """No Windows o `after` tem passo de ~15 ms; pedir 1 ms deixa o movimento mais regular."""
        if sys.platform != "win32" or ligar == self._timer_alto:
            return
        try:
            winmm = ctypes.windll.winmm
            (winmm.timeBeginPeriod if ligar else winmm.timeEndPeriod)(1)
            self._timer_alto = ligar
        except (AttributeError, OSError):
            pass

    def parar(self) -> None:
        for nome in ("_after_tick", "_after_fundo", "_after_espera"):
            id_ = getattr(self, nome)
            if id_ is not None:
                try:
                    self.after_cancel(id_)
                except tk.TclError:
                    pass
                setattr(self, nome, None)
        self._timer_preciso(False)

    def destroy(self) -> None:
        self.parar()
        super().destroy()


