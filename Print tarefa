# ---------------------------------------------------------------- cena estática
def geometria(w, h, esc):
    topo = h - 78 * esc
    return {
        "topo": topo,                    # início do tampo do balcão
        "pes": topo + 40 * esc,          # linha dos pés do gato
        "xic_x": w - 128 * esc,          # centro da xícara
        "xic_y": topo + 38 * esc,        # base da xícara
    }


def renderizar_cena(w, h, esc):
    """Parede com luz quente e balcão de madeira (uma única imagem de fundo).

    A parede é quase lisa atrás dos painéis; só o cabeçalho e o palco têm brilhos."""
    g = geometria(w, h, esc)
    sw, shh = max(8, w // 4), max(8, h // 4)
    ys = np.linspace(0, 1, shh)[:, None, None]
    alta = np.array(_rgb(T.PAREDE_ALTA), float)[None, None, :]
    base = np.array(_rgb(T.PAREDE_BASE), float)[None, None, :]
    arr = np.repeat(alta * (1 - ys) + base * ys, sw, axis=1)
    xx = np.linspace(0, w, sw)[None, :]
    yy = np.linspace(0, h, shh)[:, None]
    rng = np.random.default_rng(11)
    luz = np.array([255, 196, 120], float)
    faixa_palco = h - 214 * esc
    luzes = []
    for _ in range(5):   # cabeçalho
        luzes.append((rng.uniform(0.03, 0.97) * w, rng.uniform(0.0, 90) * esc,
                      rng.uniform(40, 85) * esc, rng.uniform(0.05, 0.10)))
    for _ in range(4):   # palco
        luzes.append((rng.uniform(0.03, 0.97) * w, rng.uniform(faixa_palco, g["topo"]),
                      rng.uniform(45, 90) * esc, rng.uniform(0.05, 0.10)))
    luzes.append((g["xic_x"], g["xic_y"] - 70 * esc, 130 * esc, 0.16))
    for cx, cy, sig, it in luzes:
        d2 = ((xx - cx) ** 2 + (yy - cy) ** 2) / (2 * sig * sig)
        arr += (np.exp(-d2) * it)[..., None] * luz
    sombra = np.clip((yy - (g["topo"] - 46 * esc)) / (46 * esc), 0, 1)
    arr *= (1 - 0.20 * sombra)[..., None]
    im = Image.fromarray(np.clip(arr, 0, 255).astype(np.uint8), "RGB").resize((w, h), Image.BICUBIC)

    d = ImageDraw.Draw(im)
    topo = int(g["topo"])
    frente = int(topo + 50 * esc)
    ca, cb = _rgb(T.MADEIRA_CLARA), _rgb(T.MADEIRA)
    for y in range(topo, frente):
        t = (y - topo) / max(1, frente - topo)
        d.line([(0, y), (w, y)], fill=tuple(int(ca[i] + (cb[i] - ca[i]) * t) for i in range(3)))
    d.rectangle([0, frente, w, h], fill=_rgb(T.MADEIRA_FRENTE))
    veio = tuple(int(c * 0.86) for c in cb)
    for fy in (0.22, 0.45, 0.7):
        y = int(topo + (frente - topo) * fy)
        d.line([(0, y), (w, y)], fill=veio, width=max(1, int(esc)))
    for x in range(int(90 * esc), w, int(260 * esc)):
        d.line([(x, topo), (x - int(12 * esc), frente)], fill=veio, width=max(1, int(1.5 * esc)))
    claro = tuple(min(255, int(c * 1.22)) for c in ca)
    d.line([(0, topo), (w, topo)], fill=claro, width=max(2, int(2 * esc)))
    d.line([(0, frente), (w, frente)], fill=tuple(int(c * 0.7) for c in _rgb(T.MADEIRA_FRENTE)),
           width=max(2, int(2 * esc)))
    escuro = tuple(int(c * 0.82) for c in _rgb(T.MADEIRA_FRENTE))
    for x in range(int(140 * esc), w, int(300 * esc)):
        d.line([(x, frente + int(3 * esc)), (x, h)], fill=escuro, width=max(1, int(2 * esc)))
    return im


