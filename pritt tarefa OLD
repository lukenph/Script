    def _atualizar_perfis(self) -> None:
        for widget in self.lista_perfis.winfo_children():
            widget.destroy()
        for nome in self.perfis:
            atual = nome == self.perfil_atual.nome
            texto = ("▌ " if atual else "  ") + nome
            botao(
                self.lista_perfis, texto, lambda n=nome: self._trocar_perfil(n),
                destaque=atual, anchor="w", height=32,
            ).pack(fill="x", padx=3, pady=2)

    def _trocar_perfil(self, nome: str) -> None:
        self._salvar_edicao()
        self._salvar_perfil()
        self.perfil_atual = self.repositorio.carregar(nome)
        self._emitir_avisos_perfis()
        self.modo = self.perfil_atual.modo
        self.ciclos = self.perfil_atual.ciclos
        self.modo_var.set(self.modo.upper())
        self.ciclos_var.set(str(self.ciclos))
        self.indice_selecionado = None
        self._atualizar_perfis()
        self._renderizar_fila()
        self._atualizar_inspecao()
        self._log_local("info", f"perfil carregado: {nome}")

    def _novo_perfil(self) -> None:
        self._salvar_edicao()
        self._salvar_perfil()
        nome = self._pedir_nome_perfil()
        if not nome:
            return
        try:
            seguro = nome_seguro(nome)
        except ValueError as erro:
            self._aviso("NOME INVÁLIDO", str(erro), erro=True)
            return
        if seguro in self.perfis:
            self._aviso("PERFIL EXISTENTE", "Esse perfil já está na lista.")
            return
        self.perfil_atual = Perfil(seguro)
        self.repositorio.salvar(self.perfil_atual)
        self.perfis = self.repositorio.listar()
        self.modo = "simples"
        self.modo_var.set("SIMPLES")
        self.ciclos_var.set("1")
        self.indice_selecionado = None
        self._atualizar_perfis()
        self._renderizar_fila()
        self._atualizar_inspecao()

    def _renderizar_fila(self) -> None:
        for widget in self.lista_fila.winfo_children():
            widget.destroy()
        for indice, alvo in enumerate(self.perfil_atual.alvos):
            selecionado = indice == self.indice_selecionado
            linha = ctk.CTkFrame(
                self.lista_fila, fg_color=cor.PAINEL if selecionado else cor.FUNDO,
                border_color=cor.BORDAS, border_width=1, corner_radius=0,
            )
            linha.pack(fill="x", padx=4, pady=4)
            linha.grid_columnconfigure(1, weight=1)
            for widget in (linha,):
                widget.bind("<Button-1>", lambda _e, i=indice: self._selecionar_alvo(i))
            ordem = rotulo(linha, f"{indice + 1:02d}", cor_texto=cor.AMBAR, tamanho=14, width=40)
            ordem.grid(row=0, column=0, rowspan=2, padx=(10, 4), pady=7)
            ordem.bind("<Button-1>", lambda _e, i=indice: self._selecionar_alvo(i))
            nome = rotulo(linha, f"▣  {alvo.nome}", cor_texto=cor.PERGAMINHO, tamanho=11)
            nome.grid(row=0, column=1, sticky="ew", padx=6, pady=(7, 2))
            nome.bind("<Button-1>", lambda _e, i=indice: self._selecionar_alvo(i))
            acao = rotulo(linha, f"ação: {alvo.acao}    ·    espera: {alvo.delay_ms} ms", cor_texto=cor.OLIVA, tamanho=9)
            acao.grid(row=1, column=1, sticky="ew", padx=6, pady=(0, 7))
            acao.bind("<Button-1>", lambda _e, i=indice: self._selecionar_alvo(i))
            estado = "selecionado" if selecionado else "aguardando"
            st = rotulo(linha, f"status: {estado}", cor_texto=cor.AMBAR if selecionado else cor.OLIVA, tamanho=9)
            st.grid(row=0, column=2, rowspan=2, padx=10)
            st.bind("<Button-1>", lambda _e, i=indice: self._selecionar_alvo(i))
        self.contagem_alvos.configure(text=f"ALVOS: {len(self.perfil_atual.alvos)}")
        self._atualizar_status()

    def _selecionar_alvo(self, indice: int) -> None:
        if self.indice_selecionado == indice:
            return
        self._salvar_edicao()
        self.indice_selecionado = indice
        self._renderizar_fila()
        self._atualizar_inspecao()

    def _atualizar_inspecao(self) -> None:
        alvo = self._alvo_selecionado()
        if not alvo:
            self._limpar_preview("[ NENHUM ALVO SELECIONADO ]")
            self.acao_var.set("clique")
            self.campo_texto.delete(0, "end")
            self.delay_var.set("450")
            self.confianca_var.set(0.85)
            self.confianca_num.configure(text="0.85")
            self.tentativas_var.set("5")
            self.intervalo_var.set("400")
            self.scroll_var.set("500")
            self.humano_var.set(False)
            return
        imagem = carregar_preview(self.raiz_dados, alvo)
        if imagem:
            ctk_imagem = ctk.CTkImage(light_image=imagem, dark_image=imagem, size=imagem.size)
            self.preview.configure(image=ctk_imagem)
            self._preview_ref = ctk_imagem
            self.preview.configure(text="")
        else:
            self._limpar_preview("[ ARQUIVO DE ALVO AUSENTE ]")
        self.acao_var.set(alvo.acao)
        self.campo_texto.delete(0, "end")
        self.campo_texto.insert(0, alvo.texto if alvo.acao == "digitar" else alvo.tecla)
        self.delay_var.set(str(alvo.delay_ms))
        self.confianca_var.set(alvo.confianca)
        self.confianca_num.configure(text=f"{alvo.confianca:.2f}")
        self.tentativas_var.set(str(alvo.tentativas))
        self.intervalo_var.set(str(alvo.intervalo_tentativa_ms))
        self.scroll_var.set(str(alvo.scroll_pixels))
        self.humano_var.set(alvo.digitar_humano)
        self._acao_alterada(alvo.acao, salvar=False)

    def _limpar_preview(self, texto: str) -> None:
        # CustomTkinter 5.2.x não limpa o tk.Label interno quando recebe image=None.
        # Retire a referência Tcl antes de liberar o CTkImage para evitar pyimageN órfã.
        rotulo_interno = getattr(self.preview, "_label", None)
        if rotulo_interno is not None:
            rotulo_interno.configure(image="")
        self.preview.configure(image=None)
        self._preview_ref = None
        self.preview.configure(text=texto)

    def _alvo_selecionado(self) -> Alvo | None:
        if self.indice_selecionado is None or not (0 <= self.indice_selecionado < len(self.perfil_atual.alvos)):
            return None
        return self.perfil_atual.alvos[self.indice_selecionado]

    def _acao_alterada(self, acao: str, salvar: bool = True) -> None:
        if acao == "digitar":
            self.rotulo_texto.configure(text="TEXTO")
            self.humano_check.grid()
        elif acao == "tecla":
            self.rotulo_texto.configure(text="TECLA / COMBINAÇÃO")
            self.humano_check.grid_remove()
        elif acao == "scroll":
            self.rotulo_texto.configure(text="ALVO PARA ROLAR")
            self.humano_check.grid_remove()
        else:
            self.rotulo_texto.configure(text="TEXTO / CHAVE")
            self.humano_check.grid_remove()
        if salvar:
            self._salvar_edicao()

    def _conf_alterada(self, valor: float) -> None:
        self.confianca_num.configure(text=f"{float(valor):.2f}")

    def _salvar_edicao(self, _evento=None) -> None:
        alvo = self._alvo_selecionado()
        if not alvo or not hasattr(self, "campo_texto"):
            return
        try:
            alvo.delay_ms = max(0, int(self.delay_var.get() or 0))
            alvo.tentativas = max(1, int(self.tentativas_var.get() or 5))
            alvo.intervalo_tentativa_ms = max(0, int(self.intervalo_var.get() or 400))
            alvo.scroll_pixels = int(self.scroll_var.get() or 500)
            alvo.confianca = min(0.99, max(0.50, float(self.confianca_var.get())))
        except ValueError:
            return
        alvo.acao = self.acao_var.get()
        valor = self.campo_texto.get()
        if alvo.acao == "digitar":
            alvo.texto = valor
        elif alvo.acao == "tecla":
            alvo.tecla = valor or "enter"
        alvo.digitar_humano = bool(self.humano_var.get())
        try:
            salvar_metadados(alvo, (self.raiz_dados / alvo.arquivo).with_suffix(".json"))
        except OSError as erro:
            self._log_local("erro", f"não foi possível salvar o alvo: {erro}")
        self._salvar_perfil()
        if hasattr(self, "lista_fila"):
            self._renderizar_fila()

    def _salvar_perfil(self) -> None:
        try:
            self.perfil_atual.modo = self.modo
            self.perfil_atual.ciclos = max(1, self.ciclos)
            self.repositorio.salvar(self.perfil_atual)
        except (OSError, ValueError) as erro:
            self._log_local("erro", f"erro salvando perfil: {erro}")

    def _modo_alterado(self, modo: str) -> None:
        self.modo = modo.lower()
        self._salvar_perfil()

    def _salvar_modo(self) -> None:
        try:
            self.ciclos = max(1, int(self.ciclos_var.get()))
        except ValueError:
            self.ciclos = 1
            self.ciclos_var.set("1")
        self._salvar_perfil()

    def _capturar(self) -> None:
        if self.executor.ativo:
            self._log_local("erro", "pare a execução antes de capturar uma tela")
            return
        self._salvar_edicao()
        self.iconify()
        self.after(500, self._abrir_overlay)

    def _abrir_overlay(self) -> None:
        try:
            self.overlay = OverlayCaptura(self, self._captura_concluida, self._captura_cancelada)
        except Exception as erro:
            self.deiconify()
            self._aviso("CAPTURA INDISPONÍVEL", str(erro), erro=True)

    def _captura_concluida(self, imagem: Image.Image, monitor: int) -> None:
        self.overlay = None
        self.deiconify()
        self.lift()
        try:
            novo = salvar_alvo(
                imagem, self.raiz_dados, self.perfil_atual.nome, monitor,
                len(self.perfil_atual.alvos) + 1,
            )
            self.perfil_atual.alvos.append(novo)
            self.indice_selecionado = len(self.perfil_atual.alvos) - 1
            self._salvar_perfil()
            self._renderizar_fila()
            self._atualizar_inspecao()
            self._log_local("ok", f"alvo capturado: {novo.nome} · monitor {monitor}")
        except Exception as erro:
            self._aviso("ERRO DE CAPTURA", str(erro), erro=True)

    def _captura_cancelada(self) -> None:
        self.overlay = None
        self.deiconify()
        self.lift()

    def _remover_alvo(self) -> None:
        self._salvar_edicao()
        alvo = self._alvo_selecionado()
        if not alvo:
            return
        # Remove da fila; preserva o PNG e o JSON no perfil para evitar perda acidental.
        alvo.in_queue = False
        try:
            salvar_metadados(alvo, (self.raiz_dados / alvo.arquivo).with_suffix(".json"))
        except OSError as erro:
            alvo.in_queue = True
            self._log_local("erro", f"não foi possível salvar a remoção: {erro}")
            return
        del self.perfil_atual.alvos[self.indice_selecionado]
        if self.perfil_atual.alvos:
            self.indice_selecionado = min(self.indice_selecionado, len(self.perfil_atual.alvos) - 1)
        else:
            self.indice_selecionado = None
        self._salvar_perfil()
        self._renderizar_fila()
        self._atualizar_inspecao()

    def _mover_alvo(self, direcao: int) -> None:
        self._salvar_edicao()
        indice = self.indice_selecionado
        destino = None if indice is None else indice + direcao
        if destino is None or not 0 <= destino < len(self.perfil_atual.alvos):
            return
        self.perfil_atual.alvos[indice], self.perfil_atual.alvos[destino] = (
            self.perfil_atual.alvos[destino], self.perfil_atual.alvos[indice]
        )
        self.indice_selecionado = destino
        self._salvar_perfil()
        self._renderizar_fila()
        self._atualizar_inspecao()

    def _duplicar_alvo(self) -> None:
        self._salvar_edicao()
        atual = self._alvo_selecionado()
        if not atual:
            return
        caminho = self.raiz_dados / atual.arquivo
        try:
            with Image.open(caminho) as img:
                copia = salvar_alvo(
                    img.copy(), self.raiz_dados, self.perfil_atual.nome,
                    atual.monitor_origem, len(self.perfil_atual.alvos) + 1,
                    nome=f"{atual.nome}_copia",
                )
            for campo in ("acao", "texto", "delay_ms", "confianca", "tentativas", "intervalo_tentativa_ms", "digitar_humano", "scroll_pixels", "tecla"):
                setattr(copia, campo, deepcopy(getattr(atual, campo)))
            salvar_metadados(copia, (self.raiz_dados / copia.arquivo).with_suffix(".json"))
            self.perfil_atual.alvos.append(copia)
            self.indice_selecionado = len(self.perfil_atual.alvos) - 1
            self._salvar_perfil()
            self._renderizar_fila()
            self._atualizar_inspecao()
        except OSError as erro:
            self._aviso("ERRO AO DUPLICAR", str(erro), erro=True)

    def _testar_alvo(self) -> None:
        if self.executor.ativo:
            self._log_local("erro", "pare a execução antes de testar um alvo")
            return
        alvo = self._alvo_selecionado()
        if not alvo:
            self._log_local("erro", "selecione um alvo para testar")
            return
        self._salvar_edicao()
        alvo_copia = deepcopy(alvo)
        restringir = self.config["restringir_monitor"]
        self._log_local("info", f"testando alvo: {alvo.nome}")

        def worker():
            try:
                resultado = localizar(
                    self.raiz_dados / alvo_copia.arquivo,
                    alvo_copia.confianca,
                    alvo_copia.tentativas,
                    alvo_copia.intervalo_tentativa_ms,
                    alvo_copia.monitor_origem,
                    restringir,
                )
                self.eventos.put(("teste", resultado, alvo_copia.nome))
            except Exception as erro:
                self.eventos.put(("teste_erro", str(erro), alvo_copia.nome))

        def iniciar_teste():
            threading.Thread(target=worker, name="cerbero-teste-alvo", daemon=True).start()

        if self.config["minimizar_ao_executar"]:
            self.minimizado_por_teste = True
            self.iconify()
            self.after(400, iniciar_teste)
        else:
            iniciar_teste()

    def _executar(self) -> None:
        self._salvar_edicao()
        self._salvar_modo()
        if self.config["bip"]:
            threading.Thread(target=self._bip, daemon=True).start()

        def iniciar_motor():
            iniciado = self.executor.iniciar(self.perfil_atual, self.modo, self.ciclos)
            if not iniciado and self.minimizado_por_execucao:
                self.minimizado_por_execucao = False
                self.deiconify()
                self.lift()

        if self.config["minimizar_ao_executar"]:
            self.minimizado_por_execucao = True
            self.iconify()
            self.after(500, iniciar_motor)
        else:
            iniciar_motor()

    @staticmethod
    def _bip() -> None:
        try:
            import winsound

            winsound.Beep(440, 150)
        except (ImportError, RuntimeError):
            pass

    def _parar(self) -> None:
        self.executor.parar()

    def _resetar(self) -> None:
        if self.executor.ativo:
            self.executor.parar("execução parada para reset")
        self.ciclo_atual = 0
        self.inicio_ativo = None
        self.status_atual = "ocioso"
        self._atualizar_status()

    def _abrir_url(self) -> None:
        url = self.url_var.get().strip()
        if not url:
            return
        if "://" not in url:
            url = "https://" + url
        webbrowser.open(url)
        self._log_local("info", f"abrindo {url}")

    def _abrir_google(self) -> None:
        webbrowser.open("https://google.com")
        self.after(900, self._focar_busca)

    def _focar_busca(self) -> None:
        try:
            pyautogui.hotkey("ctrl", "l")
        except Exception as erro:
            self._log_local("erro", f"não foi possível focar a barra do navegador: {erro}")

    def _pedir_nome_perfil(self) -> str | None:
        janela = ctk.CTkToplevel(self)
        janela.title("NOVO PERFIL")
        janela.configure(fg_color=cor.FUNDO)
        janela.geometry("390x160")
        janela.resizable(False, False)
        janela.transient(self)
        janela.grab_set()
        resultado: dict[str, str | None] = {"nome": None}
        caixa = painel(janela)
        caixa.pack(fill="both", expand=True, padx=9, pady=9)
        rotulo(caixa, "NOME DO PERFIL", cor_texto=cor.AMBAR, tamanho=12).pack(anchor="w", padx=12, pady=(12, 5))
        campo = entrada(caixa, largura=340)
        campo.pack(fill="x", padx=12, pady=4)

        def confirmar(_evento=None):
            resultado["nome"] = campo.get().strip() or None
            janela.destroy()

        acoes = ctk.CTkFrame(caixa, fg_color="transparent")
        acoes.pack(fill="x", padx=12, pady=(5, 9))
        botao(acoes, "CANCELAR", janela.destroy, width=100).pack(side="right", padx=(5, 0))
        botao(acoes, "CRIAR", confirmar, destaque=True, width=100).pack(side="right")
        janela.bind("<Return>", confirmar)
        janela.bind("<Escape>", lambda _e: janela.destroy())
        campo.focus_set()
        self.wait_window(janela)
        return resultado["nome"]

