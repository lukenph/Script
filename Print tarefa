        nh=(120.0, CHAO), fh=(136.0, CHAO), nf=(204.0, CHAO), ff=(188.0, CHAO),
    )
    return p


def montar_clips():
    stand = dict(BASE)
    return {
        "andar": [pose_andar(i / NW) for i in range(NW)],
        "parar": _trans(pose_andar(0.0), stand, 8),
        "rosnar_in": _trans(stand, pose_rosnar(0.0), 10),
        "rosnar": [pose_rosnar(i / NR) for i in range(NR)],
        "rosnar_out": _trans(pose_rosnar(0.0), stand, 10),
        "esp1": (_trans(stand, pose_downdog(0.0), 22)[:-1]
                 + [pose_downdog(i / 28) for i in range(28)]
                 + _trans(pose_downdog(1.0), stand, 18)),
        "esp2": (_trans(stand, pose_arco(0.0), 15)[:-1]
                 + [pose_arco(i / 12) for i in range(12)]
                 + _trans(pose_arco(1.0), stand, 15)),
        "partir": _trans(stand, pose_andar(0.0), 7),
    }


def tamanho_sprite(k):
