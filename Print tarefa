    # ------------------------------------------------------------ editor do alvo
    def _atualizar_inspecao(self):
        alvo = self._alvo_selecionado()
        if not alvo:
            self.editor.grid_remove()
            self.placeholder.grid()
            self.acao_var.set(ROTULOS_ACAO["clique"])
            self.campo_texto.delete(0, "end")
            self.delay_var.set("450")
            self.confianca_var.set(0.85)
            self.confianca_num.configure(text="0.85")
            self.tentativas_var.set("5")
            self.intervalo_var.set("400")
            self.scroll_var.set("500")
            self.humano_var.set(False)
            self.sensivel_var.set(False)
            self.destino_var.set("")
            return
        self.placeholder.grid_remove()
        self.editor.grid()
        imagem = carregar_preview(self.raiz_dados, alvo, limite=(340, 130))
        if imagem:
            ref = ctk.CTkImage(light_image=imagem, dark_image=imagem, size=imagem.size)
            self.preview.configure(image=ref, text="")
            self._preview_ref = ref
        else:
            self._limpar_preview("Imagem do alvo não encontrada")
        self.acao_var.set(ROTULOS_ACAO.get(alvo.acao, ROTULOS_ACAO["clique"]))
        self.campo_texto.delete(0, "end")
        self.campo_texto.insert(0, alvo.texto if alvo.acao == "digitar" else alvo.tecla)
        self.sensivel_var.set(alvo.sensivel)
        self.destino_var.set(", ".join(alvo.destinos_permitidos))
        self.campo_texto.configure(show="*" if alvo.sensivel else "")
        self.delay_var.set(str(alvo.delay_ms))
        self.confianca_var.set(alvo.confianca)
        self.confianca_num.configure(text=f"{alvo.confianca:.2f}")
        self.tentativas_var.set(str(alvo.tentativas))
        self.intervalo_var.set(str(alvo.intervalo_tentativa_ms))
        self.scroll_var.set(str(alvo.scroll_pixels))
        self.humano_var.set(alvo.digitar_humano)
        self._acao_alterada(self.acao_var.get(), salvar=False)

    def _limpar_preview(self, texto):
        interno = getattr(self.preview, "_label", None)
        if interno:
            interno.configure(image="")
        self.preview.configure(image=None, text=texto)
        self._preview_ref = None

    def _acao_alterada(self, rotulo_acao, salvar=True):
        acao = CODIGOS_ACAO.get(rotulo_acao, "clique")
        if acao in {"digitar", "tecla"}:
            self.rotulo_texto.configure(text="Texto a digitar" if acao == "digitar" else "Tecla ou combinação (ex.: ctrl+s)")
            self.rotulo_texto.grid()
            self.campo_texto.grid()
        else:
            self.rotulo_texto.grid_remove()
            self.campo_texto.grid_remove()
        for w in (self.humano_check, self.sensivel_check, self.rotulo_destinos, self.destino_entry):
            if acao == "digitar":
                w.grid()
            else:
                w.grid_remove()
        if salvar:
            self._salvar_edicao()

    def _sensivel_alterado(self):
        self.campo_texto.configure(show="*" if self.sensivel_var.get() else "")
        self._salvar_edicao()

    def _conf_alterada(self, valor):
        self.confianca_num.configure(text=f"{float(valor):.2f}")

    def _salvar_edicao(self, _evento=None):
        alvo = self._alvo_selecionado()
        if not alvo:
            return
        try:
            alvo.delay_ms = max(0, int(self.delay_var.get() or 0))
            alvo.tentativas = max(1, int(self.tentativas_var.get() or 5))
            alvo.intervalo_tentativa_ms = max(0, int(self.intervalo_var.get() or 400))
            alvo.scroll_pixels = int(self.scroll_var.get() or 500)
            alvo.confianca = min(0.99, max(0.50, float(self.confianca_var.get())))
        except ValueError:
            return
        alvo.acao = CODIGOS_ACAO.get(self.acao_var.get(), "clique")
        valor = self.campo_texto.get()
        if alvo.acao == "digitar":
            alvo.sensivel = bool(self.sensivel_var.get())
            alvo.destinos_permitidos = [x.strip() for x in re.split(r"[,;\n]+", self.destino_var.get()) if x.strip()]
            if alvo.sensivel:
                ref = _PADRAO_SEGREDO.fullmatch(valor.strip())
                if ref:
                    alvo.texto = valor.strip()
                elif valor:
                    nome = f"alvo_{alvo.id}"
                    try:
                        guardar_segredo(nome, valor)
                    except (RuntimeError, OSError, ValueError) as erro:
                        self._log_local("erro", f"senha não salva: {erro}")
                        return
                    alvo.texto = f"{{{{segredo:{nome}}}}}"
                    self.campo_texto.delete(0, "end")
                    self.campo_texto.insert(0, alvo.texto)
                else:
                    alvo.texto = ""
            else:
                alvo.texto = valor
        elif alvo.acao == "tecla":
            alvo.tecla = valor or "enter"
        alvo.digitar_humano = bool(self.humano_var.get())
        try:
            salvar_metadados(alvo, (self.raiz_dados / alvo.arquivo).with_suffix(".json"))
        except OSError as erro:
            self._log_local("erro", f"não foi possível salvar o alvo: {erro}")
        self._salvar_perfil()
        self._renderizar_fila()

    def _modo_alterado(self, valor):
        self.modo = {"Contínuo": "loop", "Ciclos": "ciclos"}.get(valor, "simples")
        self._salvar_perfil()

    # ------------------------------------------------------------ diálogos
    def _dialogo(self, titulo, largura, altura):
        e = self.esc
        jan = ctk.CTkToplevel(self)
        jan.title(titulo)
        jan.configure(fg_color=T.PAREDE_BASE)
        try:
            x = self.winfo_rootx() + (self.winfo_width() - int(largura * e)) // 2
            y = self.winfo_rooty() + (self.winfo_height() - int(altura * e)) // 3
            jan.geometry(f"{largura}x{altura}+{max(0, x)}+{max(0, y)}")
        except tk.TclError:
            jan.geometry(f"{largura}x{altura}")
        jan.resizable(False, False)
        jan.transient(self)
        jan.after(150, lambda: self._focar(jan))
        caixa = cartao(jan, raio=20)
        caixa.pack(fill="both", expand=True, padx=10, pady=10)
        return jan, caixa

    @staticmethod
    def _focar(jan):
        try:
            if jan.winfo_exists():
                jan.grab_set()
                jan.focus_force()
        except tk.TclError:
            pass

    def _abrir_configuracoes(self):
        janela, box = self._dialogo("Configurações", 470, 300)
        rotulo(box, "Configurações", tamanho=20, peso="bold", titulo=True).pack(anchor="w", padx=18, pady=(16, 8))
        variaveis = {k: ctk.BooleanVar(value=self.cfg[k]) for k in ("restringir_monitor", "bip", "minimizar_ao_executar")}
        textos = (
            ("restringir_monitor", "Procurar só no monitor onde o alvo foi capturado"),
            ("bip", "Tocar um bip ao iniciar"),
            ("minimizar_ao_executar", "Minimizar a janela enquanto executa"),
        )
        for chave, texto in textos:
            self._check(box, texto, variaveis[chave], None).pack(anchor="w", padx=20, pady=8)

        def salvar():
            self.cfg = {k: bool(v.get()) for k, v in variaveis.items()}
            self._salvar_config()
            self.executor.restringir_monitor = self.cfg["restringir_monitor"]
            janela.destroy()

        botao(box, "Aplicar", salvar, estilo="primario", height=42, corner_radius=21).pack(
            fill="x", padx=18, pady=(14, 16))

    def _confirmar_acao(self, titulo, mensagem, callback, rotulo_botao):
        w, box = self._dialogo(titulo, 440, 200)
        rotulo(box, titulo, tamanho=18, peso="bold", titulo=True).pack(anchor="w", padx=18, pady=(16, 6))
        rotulo(box, mensagem, cor=T.SUAVE, tamanho=13, wraplength=int(390 * self.esc), justify="left").pack(
            fill="x", padx=18)
        acoes = ctk.CTkFrame(box, fg_color="transparent")
        acoes.pack(fill="x", padx=18, pady=16, side="bottom")

        def confirmar():
            w.destroy()
            callback()

        botao(acoes, "Cancelar", w.destroy, width=110).pack(side="right", padx=(8, 0))
        botao(acoes, rotulo_botao, confirmar, estilo="perigo", width=150).pack(side="right")

    def _pedir_nome_perfil(self) -> str | None:
        janela, caixa = self._dialogo("Novo perfil", 400, 190)
        resultado: dict[str, str | None] = {"nome": None}
        rotulo(caixa, "Nome do perfil", tamanho=18, peso="bold", titulo=True).pack(anchor="w", padx=18, pady=(16, 6))
        campo = entrada(caixa, largura=340, height=40)
        campo.pack(fill="x", padx=18, pady=4)

        def confirmar(_evento=None):
            resultado["nome"] = campo.get().strip() or None
            janela.destroy()

        acoes = ctk.CTkFrame(caixa, fg_color="transparent")
        acoes.pack(fill="x", padx=18, pady=(8, 14))
        botao(acoes, "Cancelar", janela.destroy, width=110).pack(side="right", padx=(8, 0))
        botao(acoes, "Criar", confirmar, estilo="primario", width=110).pack(side="right")
        janela.bind("<Return>", confirmar)
        janela.bind("<Escape>", lambda _e: janela.destroy())
        campo.focus_set()
        self.wait_window(janela)
        return resultado["nome"]

    def _aviso(self, titulo: str, mensagem: str, erro: bool = False) -> None:
        janela, caixa = self._dialogo(titulo, 440, 210)
        rotulo(caixa, titulo, cor=T.TERRACOTA if erro else T.CARAMELO, tamanho=18, peso="bold", titulo=True).pack(
            anchor="w", padx=18, pady=(16, 8))
        rotulo(caixa, mensagem, cor=T.TEXTO, tamanho=13, wraplength=int(390 * self.esc), justify="left").pack(
            fill="x", padx=18, pady=(0, 8))
        botao(caixa, "Fechar", janela.destroy, width=110).pack(side="bottom", anchor="e", padx=18, pady=14)
        janela.bind("<Escape>", lambda _e: janela.destroy())

    # ------------------------------------------------------------ eventos e status
    def _consumir_eventos(self):
        try:
            while True:
                evento = self.eventos.get_nowait()
                if evento[0] == "log":
                    _, nivel, msg = evento
                    self._log_local(nivel, msg)
                elif evento[0] == "status":
                    _, estado, ciclo, inicio = evento
                    self.status_atual = estado
                    self.ciclo_atual = ciclo
                    self.inicio_ativo = inicio if estado not in {"ocioso", "parado"} else None
                    if estado in {"ocioso", "parado"} and self.minimizado_por_execucao:
                        self.minimizado_por_execucao = False
                        self.deiconify()
                        self.lift()
                    self._atualizar_status()
                elif evento[0] == "teste":
                    _, resultado, nome = evento
                    if self.minimizado_por_teste:
                        self.minimizado_por_teste = False
                        self.deiconify()
                        self.lift()
                    if resultado:
                        self._log_local("ok", f"alvo {nome} localizado em {resultado.centro} · precisão {resultado.confianca:.2f}")
                    else:
                        self._log_local("erro", f"alvo {nome} não encontrado")
                elif evento[0] == "teste_erro":
                    _, erro, nome = evento
                    self._log_local("erro", f"teste de {nome} falhou: {erro}")
        except queue.Empty:
            pass
        try:
            if self.winfo_exists():
                self.after(80, self._consumir_eventos)
        except tk.TclError:
            pass

    def _log_local(self, nivel, mensagem):
        self.log.configure(state="normal")
        self.log.insert("end", f"{time.strftime('%H:%M:%S')}  ", "tempo")
        self.log.insert("end", mensagem + "\n", nivel if nivel in {"ok", "erro", "info"} else "info")
        self.log.see("end")
        self.log.configure(state="disabled")

    def _atualizar_status(self):
        if self.status_atual in {"vendo", "agindo", "aguardando"}:
            texto, cor_texto = f"Caçando, ciclo {self.ciclo_atual}", T.SALVIA
        elif self.status_atual == "parado":
            texto, cor_texto = "Parado", T.TERRACOTA
        else:
            texto, cor_texto = "Pronto", T.SUAVE
        self.status_label.configure(text=f"●  {texto}", text_color=cor_texto)

    def _emitir_avisos_perfis(self) -> None:
        while self.repositorio.avisos:
            self._log_local("erro", self.repositorio.avisos.pop(0))

    # ------------------------------------------------------------ perfis
    def _trocar_perfil(self, nome: str) -> None:
        self._salvar_edicao()
        self._salvar_perfil()
        self.perfil_atual = self.repositorio.carregar(nome)
        self._emitir_avisos_perfis()
        self.modo = self.perfil_atual.modo
        self.ciclos = self.perfil_atual.ciclos
        self.modo_var.set(self._rotulo_modo(self.modo))
        self.ciclos_var.set(str(self.ciclos))
        self.indice_selecionado = None
        self._atualizar_perfis()
        self._renderizar_fila()
        self._atualizar_inspecao()
        self._log_local("info", f"perfil carregado: {nome}")

    def _novo_perfil(self) -> None:
        self._salvar_edicao()
        self._salvar_perfil()
        nome = self._pedir_nome_perfil()
        if not nome:
            return
        try:
            seguro = nome_seguro(nome)
        except ValueError as erro:
            self._aviso("Nome inválido", str(erro), erro=True)
            return
        if seguro in self.perfis:
            self._aviso("Perfil existente", "Esse perfil já está na lista.")
            return
        self.perfil_atual = Perfil(seguro)
        self.repositorio.salvar(self.perfil_atual)
        self.perfis = self.repositorio.listar()
        self.modo = "simples"
        self.modo_var.set("Simples")
        self.ciclos = 1
        self.ciclos_var.set("1")
        self.indice_selecionado = None
        self._atualizar_perfis()
        self._renderizar_fila()
        self._atualizar_inspecao()

    def _salvar_perfil(self) -> None:
        try:
            self.perfil_atual.modo = self.modo
            self.perfil_atual.ciclos = max(1, self.ciclos)
            self.repositorio.salvar(self.perfil_atual)
        except (OSError, ValueError) as erro:
            self._log_local("erro", f"erro salvando perfil: {erro}")

    def _salvar_modo(self) -> None:
        try:
            self.ciclos = max(1, int(self.ciclos_var.get()))
        except ValueError:
            self.ciclos = 1
            self.ciclos_var.set("1")
        self._salvar_perfil()

    # ------------------------------------------------------------ alvos
    def _selecionar_alvo(self, indice: int) -> None:
        if self.indice_selecionado == indice:
            return
        self._salvar_edicao()
        self.indice_selecionado = indice
        self._renderizar_fila()
        self._atualizar_inspecao()

    def _alvo_selecionado(self) -> Alvo | None:
        if self.indice_selecionado is None or not (0 <= self.indice_selecionado < len(self.perfil_atual.alvos)):
            return None
        return self.perfil_atual.alvos[self.indice_selecionado]

    def _capturar(self) -> None:
        if self.executor.ativo:
            self._log_local("erro", "pare a execução antes de capturar uma tela")
            return
        self._salvar_edicao()
        self.iconify()
        self.after(500, self._abrir_overlay)

    def _abrir_overlay(self) -> None:
        try:
            self.overlay = OverlayCaptura(self, self._captura_concluida, self._captura_cancelada)
        except Exception as erro:
            self.deiconify()
            self._aviso("Captura indisponível", str(erro), erro=True)

    def _captura_concluida(self, imagem: Image.Image, monitor: int) -> None:
        self.overlay = None
        self.deiconify()
        self.lift()
        try:
            novo = salvar_alvo(
                imagem, self.raiz_dados, self.perfil_atual.nome, monitor,
                len(self.perfil_atual.alvos) + 1,
            )
            self.perfil_atual.alvos.append(novo)
            self.indice_selecionado = len(self.perfil_atual.alvos) - 1
            self._salvar_perfil()
            self._renderizar_fila()
            self._atualizar_inspecao()
            self._log_local("ok", f"alvo capturado: {novo.nome} (monitor {monitor})")
        except Exception as erro:
            self._aviso("Erro de captura", str(erro), erro=True)

    def _captura_cancelada(self) -> None:
        self.overlay = None
        self.deiconify()
        self.lift()

    def _mover_alvo(self, direcao: int) -> None:
        self._salvar_edicao()
        indice = self.indice_selecionado
        destino = None if indice is None else indice + direcao
        if destino is None or not 0 <= destino < len(self.perfil_atual.alvos):
            return
        alvos = self.perfil_atual.alvos
        alvos[indice], alvos[destino] = alvos[destino], alvos[indice]
        self.indice_selecionado = destino
        self._salvar_perfil()
        self._renderizar_fila()
        self._atualizar_inspecao()

    def _testar_alvo(self) -> None:
        if self.executor.ativo:
            self._log_local("erro", "pare a execução antes de testar um alvo")
            return
        alvo = self._alvo_selecionado()
        if not alvo:
            self._log_local("erro", "selecione um alvo para testar")
            return
        self._salvar_edicao()
        alvo_copia = deepcopy(alvo)
        restringir = self.cfg["restringir_monitor"]
        self._log_local("info", f"testando alvo: {alvo.nome}")

        def worker():
            try:
                resultado = localizar(
                    self.raiz_dados / alvo_copia.arquivo,
                    alvo_copia.confianca,
                    alvo_copia.tentativas,
                    alvo_copia.intervalo_tentativa_ms,
                    alvo_copia.monitor_origem,
                    restringir,
                )
                self.eventos.put(("teste", resultado, alvo_copia.nome))
            except Exception as erro:
                self.eventos.put(("teste_erro", str(erro), alvo_copia.nome))

        def iniciar_teste():
            threading.Thread(target=worker, name="hunter-cat-teste-alvo", daemon=True).start()

        if self.cfg["minimizar_ao_executar"]:
            self.minimizado_por_teste = True
            self.iconify()
            self.after(400, iniciar_teste)
        else:
            iniciar_teste()

    def _duplicar_alvo(self) -> None:
        self._salvar_edicao()
        atual = self._alvo_selecionado()
        if not atual:
            return
        caminho = self.raiz_dados / atual.arquivo
        try:
            with Image.open(caminho) as img:
                copia = salvar_alvo(
                    img.copy(), self.raiz_dados, self.perfil_atual.nome,
                    atual.monitor_origem, len(self.perfil_atual.alvos) + 1,
                    nome=f"{atual.nome}_copia",
                )
            for campo in ("acao", "texto", "delay_ms", "confianca", "tentativas", "intervalo_tentativa_ms",
                          "digitar_humano", "scroll_pixels", "tecla", "sensivel", "destinos_permitidos"):
                setattr(copia, campo, deepcopy(getattr(atual, campo)))
            salvar_metadados(copia, (self.raiz_dados / copia.arquivo).with_suffix(".json"))
            self.perfil_atual.alvos.append(copia)
            self.indice_selecionado = len(self.perfil_atual.alvos) - 1
            self._salvar_perfil()
            self._renderizar_fila()
            self._atualizar_inspecao()
        except OSError as erro:
            self._aviso("Erro ao duplicar", str(erro), erro=True)

    def _remover_alvo(self):
        alvo = self._alvo_selecionado()
        if alvo:
            self._confirmar_acao("Remover alvo", f"Remover {alvo.nome} da fila? A imagem fica guardada na pasta.",
                                 self._remover_alvo_confirmado, "Remover")

    def _remover_alvo_confirmado(self) -> None:
        self._salvar_edicao()
        alvo = self._alvo_selecionado()
        if not alvo:
            return
        alvo.in_queue = False
        try:
            salvar_metadados(alvo, (self.raiz_dados / alvo.arquivo).with_suffix(".json"))
        except OSError as erro:
            alvo.in_queue = True
            self._log_local("erro", f"não foi possível salvar a remoção: {erro}")
            return
        del self.perfil_atual.alvos[self.indice_selecionado]
        if self.perfil_atual.alvos:
            self.indice_selecionado = min(self.indice_selecionado, len(self.perfil_atual.alvos) - 1)
        else:
            self.indice_selecionado = None
        self._salvar_perfil()
        self._renderizar_fila()
        self._atualizar_inspecao()

    # ------------------------------------------------------------ execução
    def _executar(self) -> None:
        self._salvar_edicao()
        self._salvar_modo()
        if self.cfg["bip"]:
            threading.Thread(target=self._bip, daemon=True).start()

        def iniciar_motor():
            iniciado = self.executor.iniciar(self.perfil_atual, self.modo, self.ciclos)
            if not iniciado and self.minimizado_por_execucao:
                self.minimizado_por_execucao = False
                self.deiconify()
                self.lift()

        if self.cfg["minimizar_ao_executar"]:
            self.minimizado_por_execucao = True
            self.iconify()
            self.after(500, iniciar_motor)
        else:
            iniciar_motor()

    @staticmethod
    def _bip() -> None:
        try:
            import winsound
            winsound.Beep(440, 150)
        except (ImportError, RuntimeError):
            pass

    def _parar(self) -> None:
        self.executor.parar()

    def _resetar(self) -> None:
        if self.executor.ativo:
            self.executor.parar("execução parada para reiniciar")
        self.ciclo_atual = 0
        self.inicio_ativo = None
        self.status_atual = "ocioso"
        self._atualizar_status()

    # ------------------------------------------------------------ encerramento
    def _fechar(self):
        if self.executor.ativo:
            self._confirmar_acao("Fechar o Hunter Cat", "Há uma execução em andamento. Parar e fechar?",
                                 self._fechar_confirmado, "Parar e fechar")
        else:
            self._fechar_confirmado()

    def _fechar_confirmado(self):
        self._salvar_edicao()
        self._salvar_perfil()
        self.executor.parar("aplicativo fechado")
        if self.overlay is not None:
            try:
                self.overlay.janela.destroy()
            except Exception:
                pass
        try:
            self.cena.parar()
        except Exception:
            pass
        self.destroy()


