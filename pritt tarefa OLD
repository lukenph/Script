    def _consumir_eventos(self) -> None:
        try:
            while True:
                evento = self.eventos.get_nowait()
                if evento[0] == "log":
                    _, nivel, mensagem = evento
                    self._log_local(nivel, mensagem)
                elif evento[0] == "status":
                    _, estado, ciclo, inicio = evento
                    self.status_atual = estado
                    self.ciclo_atual = ciclo
                    self.inicio_ativo = inicio if estado != "ocioso" else None
                    if estado == "ocioso" and self.minimizado_por_execucao:
                        self.minimizado_por_execucao = False
                        self.deiconify()
                        self.lift()
                    self._atualizar_status()
                elif evento[0] == "teste":
                    _, resultado, nome = evento
                    if self.minimizado_por_teste:
                        self.minimizado_por_teste = False
                        self.deiconify()
                        self.lift()
                    if resultado:
                        self._log_local("ok", f"alvo {nome} localizado em {resultado.centro} · confiança {resultado.confianca:.2f}")
                    else:
                        self._log_local("erro", f"alvo {nome} não encontrado")
                elif evento[0] == "teste_erro":
                    _, erro, nome = evento
                    if self.minimizado_por_teste:
                        self.minimizado_por_teste = False
                        self.deiconify()
                        self.lift()
                    self._log_local("erro", f"teste de {nome} falhou: {erro}")
        except queue.Empty:
            pass
        if self.winfo_exists():
            self.after(80, self._consumir_eventos)

    def _log_local(self, nivel: str, mensagem: str) -> None:
        if not hasattr(self, "log"):
            return
        horario = time.strftime("%H:%M:%S")
        self.log.configure(state="normal")
        fim = self.log.index("end-1c")
        self.log.insert("end", f"> {horario}  ", "tempo")
        self.log.insert("end", mensagem + "\n", nivel if nivel in {"ok", "erro", "info"} else "info")
        linhas = int(float(self.log.index("end-1c")))
        if linhas > 500:
            self.log.delete("1.0", f"{linhas - 500}.0")
        self.log.see("end")
        self.log.configure(state="disabled")

    def _emitir_avisos_perfis(self) -> None:
        while self.repositorio.avisos:
            self._log_local("erro", self.repositorio.avisos.pop(0))

    def _atualizar_status(self) -> None:
        ativos = "00:00:00"
        if self.inicio_ativo is not None and self.status_atual != "ocioso":
            segundos = int(time.monotonic() - self.inicio_ativo)
            horas, resto = divmod(segundos, 3600)
            minutos, segundos = divmod(resto, 60)
            ativos = f"{horas:02d}:{minutos:02d}:{segundos:02d}"
        self.status_label.configure(
            text=f"STATUS: {self.status_atual.upper()}  ·  ALVOS: {len(self.perfil_atual.alvos)}  ·  "
                 f"CICLO: {self.ciclo_atual}  ·  TEMPO ATIVO: {ativos}"
        )

    def _atualizar_relogio(self) -> None:
        if not self.winfo_exists():
            return
        self.relogio_cab.configure(text=f"[usuario@local]   ⟨{time.strftime('%H:%M:%S')}⟩")
        self._atualizar_status()
        self.after(1000, self._atualizar_relogio)

    def _fechar(self) -> None:
        self._salvar_edicao()
        self._salvar_perfil()
        self.executor.parar("painel fechado")
        if self.overlay is not None:
            try:
                self.overlay.janela.destroy()
            except Exception:
                pass
        self.destroy()


