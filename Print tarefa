        eye=0.0, anger=0.0, mouth=boca, ear=0.3,
        tail=(-84.0, 26.0, 6.0, 2 * math.pi * ph, 0.0),
        nh=(90.0, CHAO), fh=(106.0, CHAO), nf=(254.0, CHAO), ff=(238.0, CHAO),
    )
