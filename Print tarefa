class OverlayCaptura:
    def __init__(self, root: tk.Misc, ao_capturar: Callable[[Image.Image, int], None], ao_cancelar: Callable[[], None]):
        self.root = root
        self.ao_capturar = ao_capturar
        self.ao_cancelar = ao_cancelar
        self.monitor_virtual: dict
        self.monitores: list[dict]
        with mss.MSS() as sct:
            self.monitores = list(sct.monitors[1:])
            if not self.monitores:
                raise RuntimeError("Nenhum monitor disponível para captura.")
            self.monitor_virtual = dict(sct.monitors[0])
            shot = sct.grab(self.monitor_virtual)
            self.imagem = Image.frombytes("RGB", shot.size, shot.rgb)

        self.inicio: tuple[int, int] | None = None
        self.retangulo: int | None = None
        self.mira_h: int | None = None
        self.mira_v: int | None = None
        self.janela = tk.Toplevel(root)
        self.janela.title("Capturar alvo")
        self.janela.configure(bg=T.ESPRESSO, cursor="crosshair")
        self.janela.attributes("-topmost", True)
        try:
            self.janela.attributes("-alpha", 0.60)
        except tk.TclError:
            pass
        self.janela.overrideredirect(True)
        x = self.monitor_virtual["left"]
        y = self.monitor_virtual["top"]
        largura = self.monitor_virtual["width"]
        altura = self.monitor_virtual["height"]
        if sys.platform == "win32":
            self.janela.geometry(f"{largura}x{altura}+0+0")
            self.janela.update_idletasks()
            user32 = ctypes.windll.user32
            user32.SetWindowPos.argtypes = [
                ctypes.c_void_p, ctypes.c_void_p, ctypes.c_int, ctypes.c_int,
                ctypes.c_int, ctypes.c_int, ctypes.c_uint,
            ]
            user32.SetWindowPos.restype = ctypes.c_bool
            user32.SetWindowPos(
                ctypes.c_void_p(self.janela.winfo_id()), ctypes.c_void_p(-1),
                int(x), int(y), int(largura), int(altura), 0x0040,
            )
        else:
            self.janela.geometry(f"{largura}x{altura}{x:+d}{y:+d}")
        self.canvas = tk.Canvas(self.janela, bg=T.ESPRESSO, highlightthickness=0, cursor="crosshair")
        self.canvas.pack(fill="both", expand=True)
        self.canvas.create_text(
            28, 28, anchor="nw", text="Arraste sobre o que o gato deve procurar.  Esc cancela.",
            fill=T.CARAMELO, font=fonte(root, 14, "bold"),
        )
        self.canvas.bind("<Motion>", self._mover)
        self.canvas.bind("<ButtonPress-1>", self._iniciar)
        self.canvas.bind("<B1-Motion>", self._arrastar)
        self.canvas.bind("<ButtonRelease-1>", self._soltar)
        self.janela.bind("<Escape>", self.cancelar)
        self.janela.focus_force()

    def _mover(self, evento) -> None:
        x, y = evento.x, evento.y
        largura = self.monitor_virtual["width"]
        altura = self.monitor_virtual["height"]
        if self.mira_h is not None:
            self.canvas.delete(self.mira_h)
            self.canvas.delete(self.mira_v)
        self.mira_h = self.canvas.create_line(0, y, largura, y, fill=T.CARAMELO, width=1)
        self.mira_v = self.canvas.create_line(x, 0, x, altura, fill=T.CARAMELO, width=1)
        if self.retangulo is not None:
            self.canvas.tag_raise(self.retangulo)

    def _iniciar(self, evento) -> None:
        self.inicio = (evento.x, evento.y)
        if self.retangulo is not None:
            self.canvas.delete(self.retangulo)
        self.retangulo = self.canvas.create_rectangle(
            evento.x, evento.y, evento.x, evento.y,
            outline=T.CARAMELO, width=2, fill=T.CARAMELO, stipple="gray25",
        )

    def _arrastar(self, evento) -> None:
        if self.inicio is not None and self.retangulo is not None:
            self.canvas.coords(self.retangulo, *self.inicio, evento.x, evento.y)

    def _soltar(self, evento) -> None:
        if self.inicio is None:
            return
        x1, x2 = sorted((self.inicio[0], evento.x))
        y1, y2 = sorted((self.inicio[1], evento.y))
        if x2 - x1 < 3 or y2 - y1 < 3:
            return
        recorte = self.imagem.crop((x1, y1, x2, y2))
        centro_x = self.monitor_virtual["left"] + (x1 + x2) // 2
        centro_y = self.monitor_virtual["top"] + (y1 + y2) // 2
        monitor_id = 1
        for indice, monitor in enumerate(self.monitores, start=1):
            if (monitor["left"] <= centro_x < monitor["left"] + monitor["width"]
                    and monitor["top"] <= centro_y < monitor["top"] + monitor["height"]):
                monitor_id = indice
                break
        self.janela.destroy()
        self.ao_capturar(recorte, monitor_id)

    def cancelar(self, _evento=None) -> None:
        if self.janela.winfo_exists():
            self.janela.destroy()
        self.ao_cancelar()


