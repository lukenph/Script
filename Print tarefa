def desenhar_xicara(k):
    W, Hh = 120, 92
    p = _Pincel(k, W, Hh)
    ol = C_CONTORNO
    # sombra suave
    for rx, ry, a in ((54, 9.5, 22), (46, 8, 34), (38, 6.5, 46)):
        p.poly(_elipse(60, 82, rx, ry), (0, 0, 0, a))
    # pires
