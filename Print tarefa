class JanelaHunterCat(ctk.CTk):
    def __init__(self):
        ctk.set_appearance_mode("Dark")
        super().__init__(fg_color=T.PAREDE_BASE)
        self.raiz_dados = Path(__file__).resolve().parent
        self.repositorio = RepositorioPerfis(self.raiz_dados)
        self.eventos: queue.Queue = queue.Queue()
        self.config_path = self.raiz_dados / "configuracoes.json"
        self.cfg = self._ler_config()
        self.executor = Executor(
            self.raiz_dados, self.eventos,
            restringir_monitor=self.cfg["restringir_monitor"],
        )
        self.perfis = self.repositorio.listar()
        if not self.perfis:
            self.repositorio.salvar(Perfil("padrao"))
            self.perfis = ["padrao"]
        self.perfil_atual = self.repositorio.carregar(self.perfis[0])
        self.indice_selecionado: int | None = None
        self.modo, self.ciclos = self.perfil_atual.modo, self.perfil_atual.ciclos
        self.inicio_ativo = None
        self.ciclo_atual, self.status_atual = 0, "ocioso"
        self.minimizado_por_execucao = False
        self.minimizado_por_teste = False
        self.overlay: OverlayCaptura | None = None
        self._preview_ref = None
        self.esc = self._detectar_escala()

        self.acao_var = ctk.StringVar(value=ROTULOS_ACAO["clique"])
        self.modo_var = ctk.StringVar(value=self._rotulo_modo(self.modo))
        self.ciclos_var = ctk.StringVar(value=str(self.ciclos))
        self.confianca_var = ctk.DoubleVar(value=0.85)
        self.humano_var = ctk.BooleanVar(value=False)
        self.delay_var = ctk.StringVar(value="450")
        self.tentativas_var = ctk.StringVar(value="5")
        self.intervalo_var = ctk.StringVar(value="400")
        self.scroll_var = ctk.StringVar(value="500")
        self.sensivel_var = ctk.BooleanVar(value=False)
        self.destino_var = ctk.StringVar(value="")

        self._montar_janela()
        self.cena = Cena(self, self.esc)
        self._montar_interface()
        self._atualizar_perfis()
        self._renderizar_fila()
        self._atualizar_inspecao()
        self._atualizar_status()
        self._emitir_avisos_perfis()
        self.after(80, self._consumir_eventos)
        self.protocol("WM_DELETE_WINDOW", self._fechar)
        self.bind_all("<Escape>", lambda _e: self._parar())
        self.bind_all("<F12>", lambda _e: self._parar())

    # ------------------------------------------------------------ base
    def _detectar_escala(self) -> float:
        for obter in (lambda: self._get_window_scaling(), lambda: ctk.ScalingTracker.get_window_scaling(self)):
            try:
                valor = float(obter())
                if valor > 0:
                    return valor
            except Exception:
                continue
        try:
            return max(1.0, self.winfo_fpixels("1i") / 96.0)
        except tk.TclError:
            return 1.0

    def _ler_config(self):
        padrao = {"restringir_monitor": False, "bip": False, "minimizar_ao_executar": True}
        try:
            dados = json.loads(self.config_path.read_text(encoding="utf-8"))
            if isinstance(dados, dict):
                padrao.update({k: dados[k] for k in padrao if k in dados})
        except (OSError, ValueError, TypeError):
            pass
        return padrao

    def _salvar_config(self):
        tmp = self.config_path.with_suffix(".json.tmp")
        tmp.write_text(json.dumps(self.cfg, ensure_ascii=False, indent=2), encoding="utf-8")
        tmp.replace(self.config_path)

    @staticmethod
    def _rotulo_modo(modo):
        return {"loop": "Contínuo", "ciclos": "Ciclos"}.get(modo, "Simples")

    def _montar_janela(self):
        self.title("Hunter Cat")
        self.geometry("1440x900")
        self.minsize(1120, 720)
        if sys.platform == "win32":
            self.after(80, self._maximizar)

    def _maximizar(self):
        try:
            self.state("zoomed")
        except tk.TclError:
            pass

    # ------------------------------------------------------------ layout
    def _montar_interface(self):
        e = self.esc
        self.grid_columnconfigure(0, weight=0, minsize=int(252 * e))
        self.grid_columnconfigure(1, weight=1, minsize=int(440 * e))
        self.grid_columnconfigure(2, weight=0, minsize=int(392 * e))
        self.grid_rowconfigure(0, weight=0, minsize=int(100 * e))   # cabeçalho (desenhado na cena)
        self.grid_rowconfigure(1, weight=1)
        self.grid_rowconfigure(2, weight=0, minsize=int(214 * e))   # palco do gato (desenhado na cena)
        self._topo()
        self._coluna_perfis()
        self._coluna_centro()
