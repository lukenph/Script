import json
import re
from pathlib import Path



def nome_seguro(nome: str) -> str:
    limpo = re.sub(r"[^\w.-]+", "_", nome.strip(), flags=re.UNICODE).strip("._")
    if not limpo or limpo in {".", ".."}:
        raise ValueError("Dê ao perfil um nome com letras ou números.")
    return limpo[:64]


class RepositorioPerfis:
    def __init__(self, raiz: Path):
        self.raiz = raiz
        self.pasta = raiz / "perfis"
        self.avisos: list[str] = []
        self.pasta.mkdir(parents=True, exist_ok=True)
        (raiz / "alvos").mkdir(parents=True, exist_ok=True)

    def listar(self) -> list[str]:
        return sorted(p.stem for p in self.pasta.glob("*.json") if p.is_file())

    def _validar_caminho_alvo(self, perfil: str, arquivo: str) -> Path:
        if not isinstance(arquivo, str):
            raise ValueError("O caminho do alvo precisa ser texto.")
        raiz = self.raiz.resolve()
        pasta_perfil = (raiz / "alvos" / perfil).resolve()
        caminho = (raiz / arquivo).resolve()
        caminho.relative_to(raiz)
        if caminho.parent != pasta_perfil or caminho.suffix.lower() != ".png":
            raise ValueError(f"Arquivo de alvo fora da pasta do perfil: {arquivo}")
        return caminho

    def carregar(self, nome: str) -> Perfil:
        seguro = nome_seguro(nome)
        caminho = self.pasta / f"{seguro}.json"
        if not caminho.exists():
            return Perfil(nome=seguro)
        try:
            dados = json.loads(caminho.read_text(encoding="utf-8"))
            perfil = Perfil.de_dict(dados)
            perfil.nome = seguro
            alvos_validos: list[Alvo] = []
            for alvo in perfil.alvos:
                try:
                    self._validar_caminho_alvo(seguro, alvo.arquivo)
                    alvos_validos.append(alvo)
                except (OSError, TypeError, ValueError):
                    self.avisos.append(f"caminho inválido ignorado no perfil {seguro}: {alvo.arquivo}")
            perfil.alvos = alvos_validos
            return perfil
        except (OSError, ValueError, TypeError) as erro:
            recuperados: list[Alvo] = []
            pasta_alvos = (self.raiz / "alvos" / seguro).resolve()
            for arquivo_json in sorted(pasta_alvos.glob("*.json")):
                try:
                    alvo = Alvo.de_dict(json.loads(arquivo_json.read_text(encoding="utf-8")))
                    caminho_png = (self.raiz / alvo.arquivo).resolve()
                    caminho_png.relative_to(self.raiz.resolve())
                    if (alvo.in_queue and caminho_png.parent == pasta_alvos and caminho_png.suffix.lower() == ".png"
                            and caminho_png.is_file() and alvo.id == arquivo_json.stem):
                        recuperados.append(alvo)
                except (OSError, ValueError, TypeError):
                    continue
            recuperados.sort(key=lambda alvo: (alvo.ordem, alvo.id))
            if recuperados:
                perfil = Perfil(nome=seguro, alvos=recuperados)
                self.salvar(perfil)
                self.avisos.append(
                    f"perfil {seguro} estava corrompido; fila recuperada de {len(recuperados)} JSON(s) de alvo"
                )
                return perfil
            self.avisos.append(
                f"perfil {seguro} não pôde ser lido ({erro}); nenhum alvo foi recuperado"
            )
            return Perfil(nome=seguro)

    def salvar(self, perfil: Perfil) -> None:
        seguro = nome_seguro(perfil.nome)
        perfil.nome = seguro
        for ordem, alvo in enumerate(perfil.alvos, start=1):
            self._validar_caminho_alvo(seguro, alvo.arquivo)
            alvo.ordem = ordem
            alvo.in_queue = True
            salvar_metadados(alvo, caminho_metadados(self.raiz, alvo))
        caminho = self.pasta / f"{seguro}.json"
        temporario = caminho.with_suffix(".json.tmp")
        temporario.write_text(
            json.dumps(perfil.para_dict(), ensure_ascii=False, indent=2),
            encoding="utf-8",
        )
        temporario.replace(caminho)


