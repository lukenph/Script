from __future__ import annotations

# DPI awareness must be set before MSS, Tk, or PyAutoGUI read screen metrics.
import sys as _dpi_sys
if _dpi_sys.platform == "win32":
    import ctypes as _dpi_ctypes
    try:
        _dpi_ctypes.windll.shcore.SetProcessDpiAwareness(2)
    except (AttributeError, OSError):
        try:
            _dpi_ctypes.windll.user32.SetProcessDPIAware()
