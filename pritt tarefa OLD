import time
from dataclasses import dataclass
from pathlib import Path
from typing import Callable

import cv2
import mss
import numpy as np


# Include the captured size plus nearby scales so resizing a browser or game
# window does not make an otherwise identical target impossible to find.
_ESCALAS_TEMPLATE = (0.65, 0.75, 0.85, 0.95, 1.0, 1.10, 1.20, 1.30, 1.40, 1.50)


@dataclass
class Correspondencia:
    x: int
    y: int
    largura: int
    altura: int
    confianca: float
    monitor: int

    @property
    def centro(self) -> tuple[int, int]:
        return self.x + self.largura // 2, self.y + self.altura // 2


def _normalizar(cinza: np.ndarray) -> np.ndarray:
    # Equalização local reduz variações de brilho; normalização mantém os dois
    # lados do casamento na mesma escala antes do TM_CCOEFF_NORMED.
    equalizada = cv2.equalizeHist(cinza)
    return cv2.normalize(equalizada, None, 0, 255, cv2.NORM_MINMAX)


def carregar_template(caminho: Path) -> np.ndarray:
    imagem = cv2.imread(str(caminho), cv2.IMREAD_GRAYSCALE)
    if imagem is None or imagem.size == 0:
        raise ValueError(f"Não foi possível abrir o alvo: {caminho}")
    return _normalizar(imagem)


def buscar_uma_vez(
    template: np.ndarray,
    confianca_minima: float,
    monitor_origem: int = 0,
    restringir_monitor: bool = False,
) -> Correspondencia | None:
    """Examina o monitor virtual ou todos os monitores físicos configurados."""
    with mss.MSS() as capturador:
        monitores = capturador.monitors[1:]
        if not monitores:
            return None
        if restringir_monitor and 1 <= monitor_origem <= len(monitores):
            candidatos = [(monitor_origem, monitores[monitor_origem - 1])]
        else:
            candidatos = list(enumerate(monitores, start=1))

        melhor: Correspondencia | None = None
        for indice, monitor in candidatos:
            frame = np.asarray(capturador.grab(monitor))
            # MSS fornece BGRA; o conversor correto preserva a luminância capturada.
            cinza = cv2.cvtColor(frame, cv2.COLOR_BGRA2GRAY)
            cinza = _normalizar(cinza)
            altura, largura = cinza.shape[:2]
            altura_original, largura_original = template.shape[:2]
            for escala in _ESCALAS_TEMPLATE:
                largura_template = max(1, round(largura_original * escala))
                altura_template = max(1, round(altura_original * escala))
                if altura_template > altura or largura_template > largura:
                    continue
                if escala == 1.0:
                    template_escala = template
                else:
                    interpolacao = cv2.INTER_AREA if escala < 1.0 else cv2.INTER_CUBIC
                    template_escala = cv2.resize(
                        template, (largura_template, altura_template), interpolation=interpolacao
                    )
                    template_escala = _normalizar(template_escala)
                resultado = cv2.matchTemplate(cinza, template_escala, cv2.TM_CCOEFF_NORMED)
                _, valor, _, local = cv2.minMaxLoc(resultado)
                if melhor is None or valor > melhor.confianca:
                    melhor = Correspondencia(
                        x=int(monitor["left"] + local[0]),
                        y=int(monitor["top"] + local[1]),
                        largura=largura_template,
                        altura=altura_template,
                        confianca=float(valor),
                        monitor=indice,
                    )
        if melhor and melhor.confianca >= confianca_minima:
            return melhor
        return None


def localizar(
    caminho: Path,
    confianca_minima: float = 0.85,
    tentativas: int = 5,
    intervalo_ms: int = 400,
    monitor_origem: int = 0,
    restringir_monitor: bool = False,
    cancelado: Callable[[], bool] | None = None,
    ao_tentar: Callable[[int, float | None], None] | None = None,
) -> Correspondencia | None:
    """Repete a busca sem bloquear a UI; cada tentativa pode ser cancelada."""
    template = carregar_template(caminho)
    total = max(1, tentativas)
    for tentativa in range(1, total + 1):
        if cancelado and cancelado():
            return None
        achado = buscar_uma_vez(
            template, confianca_minima, monitor_origem, restringir_monitor
        )
        if ao_tentar:
            ao_tentar(tentativa, achado.confianca if achado else None)
        if achado:
            return achado
        if tentativa < total:
            fim = time.monotonic() + max(0, intervalo_ms) / 1000
            while time.monotonic() < fim:
                if cancelado and cancelado():
                    return None
                time.sleep(min(0.05, max(0, fim - time.monotonic())))
    return None


# ==================== motor/acoes.py ====================



import random
import time
from typing import Any


ACOES = (
    "clique",
    "clique_duplo",
    "clique_direito",
    "digitar",
    "tecla",
    "scroll",
    "esperar",
    "pausar_ate_encontrar",
)


def _controlador(direct_input: bool) -> tuple[Any, bool]:
    if direct_input:
        try:
            import pydirectinput

            pydirectinput.FAILSAFE = True
            pydirectinput.PAUSE = 0
            return pydirectinput, False
        except ImportError:
            # Keep web/UI actions working if the optional game backend is absent.
            # The executor reports that this fallback may not work in games.
            pass
    import pyautogui

    pyautogui.FAILSAFE = True
    pyautogui.PAUSE = 0
    return pyautogui, bool(direct_input)


def executar_acao(
    acao: str,
    posicao: tuple[int, int] | None,
    texto: str,
    tecla: str,
    scroll_pixels: int,
    digitar_humano: bool,
    direct_input: bool,
) -> bool:
    controle, usou_reserva = _controlador(direct_input)
    if acao in {"clique", "clique_duplo", "clique_direito"}:
        if posicao is None:
            raise ValueError("A ação de mouse precisa de um alvo localizado.")
        controle.moveTo(*posicao, duration=0)
        if acao == "clique":
            controle.click()
        elif acao == "clique_duplo":
            controle.doubleClick()
        else:
            controle.rightClick()
    elif acao == "digitar":
        if posicao is None:
            raise ValueError("A ação de digitar precisa de um campo localizado.")
        controle.click(*posicao)
        time.sleep(0.08)
        if digitar_humano:
            for indice, caractere in enumerate(texto):
                controle.write(caractere)
                if indice < len(texto) - 1:
                    time.sleep(random.uniform(0.04, 0.12))
        else:
            controle.write(texto)
    elif acao == "tecla":
        teclas = [parte.strip() for parte in tecla.lower().replace("+", " ").split() if parte.strip()]
        if not teclas:
            raise ValueError("Informe uma tecla ou combinação, como ctrl+s.")
        if len(teclas) == 1:
            controle.press(teclas[0])
        else:
            controle.hotkey(*teclas)
    elif acao == "scroll":
        if posicao is None:
            raise ValueError("A ação de scroll precisa de um alvo localizado.")
        controle.moveTo(*posicao, duration=0)
        # APIs de mouse recebem passos da roda; 40 px é a aproximação por passo.
        controle.scroll(round(int(scroll_pixels) / 40))
    elif acao in {"esperar", "pausar_ate_encontrar"}:
        return False
    else:
        raise ValueError(f"Ação desconhecida: {acao}")
    return usou_reserva


# ==================== motor/executor.py ====================



import queue
import threading
import time
from pathlib import Path
from typing import Callable



class Executor:
    def __init__(
        self,
        raiz: Path,
        eventos: queue.Queue,
        restringir_monitor: bool = False,
        direct_input: bool = False,
    ):
        self.raiz = raiz
        self.eventos = eventos
        self.restringir_monitor = restringir_monitor
        self.direct_input = direct_input
        self.parar_evento = threading.Event()
        self.thread: threading.Thread | None = None
        self.inicio: float | None = None
        self.ciclo = 0
        self._listener = None

    @property
    def ativo(self) -> bool:
        return bool(self.thread and self.thread.is_alive())

    def iniciar(self, perfil: Perfil, modo: str, ciclos: int) -> bool:
        if self.ativo:
            return False
        if not perfil.alvos:
            self.eventos.put(("log", "erro", "fila vazia; adicione um alvo antes de executar"))
            return False
        self.parar_evento.clear()
        self.ciclo = 0
        self.thread = threading.Thread(
            target=self._rodar, args=(perfil, modo, max(1, ciclos)),
            name="cerbero-executor", daemon=True,
        )
        self.thread.start()
        return True

    def parar(self, motivo: str = "parada solicitada") -> None:
        if self.ativo:
            self.eventos.put(("log", "info", motivo))
            self.parar_evento.set()

    def _registrar_hotkey(self) -> None:
        # pynput escuta em nível global, inclusive se o painel estiver minimizado.
        try:
            from pynput import keyboard

            def ao_pressionar(tecla):
                if tecla in (keyboard.Key.esc, keyboard.Key.f12):
                    self.parar("botão de pânico acionado")

            self._listener = keyboard.Listener(on_press=ao_pressionar)
            self._listener.daemon = True
            self._listener.start()
            return
        except Exception:
            self._listener = None
        try:
            import keyboard

            keyboard.add_hotkey("esc", lambda: self.parar("botão de pânico acionado"))
            keyboard.add_hotkey("f12", lambda: self.parar("botão de pânico acionado"))
            self._listener = "keyboard"
        except Exception as erro:
            self.eventos.put(("log", "erro", f"hotkey global indisponível: {erro}"))

    def _remover_hotkey(self) -> None:
        if self._listener == "keyboard":
            try:
                import keyboard

                keyboard.unhook_all_hotkeys()
            except Exception:
                pass
        elif self._listener is not None:
            try:
                self._listener.stop()
            except Exception:
                pass
        self._listener = None

    def _log(self, nivel: str, mensagem: str) -> None:
        self.eventos.put(("log", nivel, mensagem))

    def _localizar(self, alvo, infinito: bool = False) -> Correspondencia | None:
        caminho = self.raiz / alvo.arquivo
        if not caminho.is_file():
            self._log("erro", f"alvo ausente: {alvo.nome}")
            return None
        while not self.parar_evento.is_set():
            def registrar_tentativa(numero: int, confianca: float | None) -> None:
                total = max(1, int(alvo.tentativas))
                if not infinito and confianca is None and numero < total:
                    self._log("info", f"alvo {alvo.nome} abaixo da confiança; retentando ({numero}/{total})")

            resultado = localizar(
                caminho,
                confianca_minima=float(alvo.confianca),
                tentativas=1 if infinito else int(alvo.tentativas),
                intervalo_ms=int(alvo.intervalo_tentativa_ms),
                monitor_origem=int(alvo.monitor_origem),
                restringir_monitor=self.restringir_monitor,
                cancelado=self.parar_evento.is_set,
                ao_tentar=registrar_tentativa,
            )
            if resultado:
                return resultado
            if not infinito or self.parar_evento.is_set():
                return None
            self.eventos.put(("status", "aguardando", self.ciclo, self.inicio))
            self.parar_evento.wait(max(0, int(alvo.intervalo_tentativa_ms)) / 1000)
        return None

    def _esperar_cooperativo(self, milissegundos: int) -> None:
        self.parar_evento.wait(max(0, milissegundos) / 1000)

    def _executar_alvo(self, alvo, indice: int) -> None:
        if self.parar_evento.is_set():
            return
        self.eventos.put(("status", "executando", self.ciclo, self.inicio))
        posicao: tuple[int, int] | None = None
        correspondencia = None
        if alvo.acao == "pausar_ate_encontrar":
            self._log("info", f"aguardando alvo {indice:02d}: {alvo.nome}")
            correspondencia = self._localizar(alvo, infinito=True)
        elif alvo.acao not in {"esperar"}:
            self._log("info", f"buscando alvo {indice:02d}: {alvo.nome}")
            correspondencia = self._localizar(alvo)
            if correspondencia is None:
                if not self.parar_evento.is_set():
                    self._log("erro", f"alvo {indice:02d} não localizado; seguindo para o próximo")
                return
            posicao = correspondencia.centro
            self._log(
                "ok",
                f"alvo {indice:02d} localizado em ({posicao[0]}, {posicao[1]}) · "
                f"confiança {correspondencia.confianca:.2f}",
            )
        if self.parar_evento.is_set():
            return
        try:
            if alvo.acao == "esperar":
                self._log("info", f"esperando {alvo.delay_ms} ms")
                self._esperar_cooperativo(alvo.delay_ms)
            elif alvo.acao == "pausar_ate_encontrar":
                if correspondencia:
                    self._log("ok", f"alvo {indice:02d} encontrado; fila liberada")
                else:
                    return
            else:
                usou_reserva = executar_acao(
                    alvo.acao, posicao, alvo.texto, alvo.tecla,
                    alvo.scroll_pixels, alvo.digitar_humano, self.direct_input,
                )
                if usou_reserva:
                    self._log(
                        "erro",
                        "pydirectinput não está instalado neste Python; foi usado PyAutoGUI. "
                        "Em alguns jogos, instale pydirectinput para receber os comandos.",
                    )
                self._log("ok", f"ação {alvo.acao} concluída · {alvo.nome}")
        except Exception as erro:
            if erro.__class__.__name__ == "FailSafeException":
                self.parar_evento.set()
                self._log("erro", "fail-safe do mouse acionado; execução interrompida")
            else:
                self._log("erro", f"falha em {alvo.nome}: {erro}")
        if alvo.acao != "esperar":
            self._esperar_cooperativo(alvo.delay_ms)

    def _rodar(self, perfil: Perfil, modo: str, ciclos: int) -> None:
        self.inicio = time.monotonic()
        self._registrar_hotkey()
        self.eventos.put(("status", "executando", self.ciclo, self.inicio))
        self._log("info", f"varredura iniciada · perfil {perfil.nome} · ESC/F12 para parar")
        volta = 0
        try:
            while not self.parar_evento.is_set():
                volta += 1
                self.ciclo = volta
                self.eventos.put(("status", "executando", self.ciclo, self.inicio))
                for indice, alvo in enumerate(perfil.alvos, start=1):
                    if self.parar_evento.is_set():
                        break
                    self._executar_alvo(alvo, indice)
                if modo == "simples" or (modo == "ciclos" and volta >= ciclos):
                    break
        except Exception as erro:
            self._log("erro", f"execução interrompida: {erro}")
        finally:
            self._remover_hotkey()
            self.eventos.put(("status", "ocioso", self.ciclo, self.inicio))
            self._log("info", "execução encerrada")


