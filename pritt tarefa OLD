import json
import uuid
from pathlib import Path

from PIL import Image

_PIL_RESAMPLING = getattr(Image, "Resampling", Image)
_PIL_LANCZOS = getattr(_PIL_RESAMPLING, "LANCZOS", getattr(Image, "ANTIALIAS", 1))



def diretorio_alvos(raiz: Path, perfil: str) -> Path:
    pasta = raiz / "alvos" / perfil
    pasta.mkdir(parents=True, exist_ok=True)
    return pasta


def salvar_alvo(
    imagem: Image.Image,
    raiz: Path,
    perfil: str,
    monitor_origem: int,
    ordem: int,
    nome: str | None = None,
) -> Alvo:
    """Salva cada recorte como PNG e mantém sua configuração num JSON irmão."""
    alvo_id = uuid.uuid4().hex
    pasta = diretorio_alvos(raiz, perfil)
    caminho_png = pasta / f"{alvo_id}.png"
    caminho_json = pasta / f"{alvo_id}.json"
    imagem.convert("RGB").save(caminho_png, format="PNG", optimize=True)
    alvo = Alvo(
        id=alvo_id,
        nome=nome or f"alvo_{ordem:02d}",
        arquivo=str(caminho_png.relative_to(raiz)),
        ordem=ordem,
        monitor_origem=monitor_origem,
    )
    salvar_metadados(alvo, caminho_json)
    return alvo


def salvar_metadados(alvo: Alvo, caminho: Path) -> None:
    caminho.parent.mkdir(parents=True, exist_ok=True)
    temporario = caminho.with_suffix(".json.tmp")
    temporario.write_text(
        json.dumps(alvo.para_dict(), ensure_ascii=False, indent=2), encoding="utf-8"
    )
    temporario.replace(caminho)


def caminho_metadados(raiz: Path, alvo: Alvo) -> Path:
    return (raiz / alvo.arquivo).with_suffix(".json")


def carregar_metadados(raiz: Path, arquivo_png: str) -> Alvo | None:
    caminho_png = raiz / arquivo_png
    caminho_json = caminho_png.with_suffix(".json")
    if not caminho_json.exists():
        return None
    try:
        return Alvo.de_dict(json.loads(caminho_json.read_text(encoding="utf-8")))
    except (OSError, ValueError, TypeError):
        return None


def carregar_preview(raiz: Path, alvo: Alvo, limite: tuple[int, int] = (260, 185)) -> Image.Image | None:
    caminho = raiz / alvo.arquivo
    if not caminho.is_file():
        return None
    try:
        imagem = Image.open(caminho).convert("RGB")
        imagem.thumbnail(limite, _PIL_LANCZOS)
        return imagem.copy()
    except OSError:
        return None


