    # alça
    p.poly(_elipse(98, 50, 16.8, 14.6), ol)
    p.poly(_elipse(98, 50, 15, 12.8), _c("#EFE2CF"))
    p.poly(_elipse(98, 50, 9.6, 8.2), ol)
    p.poly(_elipse(98, 50, 7.8, 6.5), (0, 0, 0, 0))
    # corpo
    lado_e = [(22, 40), (24, 52), (30, 64), (37, 72)]
    lado_d = [(83, 72), (90, 64), (96, 52), (98, 40)]
    arco = [(60 + 23 * math.cos(math.radians(a)), 72 + 6.5 * math.sin(math.radians(a))) for a in range(170, 9, -10)]
    corpo = lado_e + arco[::-1] + lado_d
    p.poly(_expandir(corpo, 1.8), ol)
    p.poly(corpo, _c("#F7EEDF"))
    p.poly([(86, 42), (98, 40), (96, 52), (90, 64), (83, 72), (76, 74), (80, 62), (84, 50)], _c("#E8D9C2"))
    # boca da xícara e café
    p.poly(_elipse(60, 39, 39.8, 11.2), ol)
    p.poly(_elipse(60, 39, 38, 9.8), _c("#FFF7EA"))
    p.poly(_elipse(60, 40, 33, 8.2), _c("#4A2A1A"))
    p.poly(_elipse(60, 40.6, 31.2, 7.2), _c("#7B4A2B"))
    p.poly(_elipse(60, 40.6, 24, 5.3), _c("#8A5733"))
    # coração de latte art
    coracao = []
    for i in range(41):
        t = 2 * math.pi * i / 40
        x = 16 * math.sin(t) ** 3
        y = -(13 * math.cos(t) - 5 * math.cos(2 * t) - 2 * math.cos(3 * t) - math.cos(4 * t))
        coracao.append((60 + x * 0.62, 40.6 + y * 0.2 + 0.4))
    p.poly(coracao, _c("#F3DFC2"))
    return p.pronto()


def gerar_vapor(k, n=48):
    """Fumaça em laço perfeito: cada partícula sobe, se alarga e some."""
    W, Hh = 90, 120
    ss = 2
    w, h = max(8, round(W * k)), max(8, round(Hh * k))
    m = ss * w / W
    correntes = [(29.0, 7.0, 1.3, 0.0), (45.0, 8.0, 1.0, 2.1), (61.0, 6.5, 1.4, 4.2)]
    saida = []
    for f in range(n):
        t = f / n
        mask = Image.new("L", (w * ss, h * ss), 0)
        d = ImageDraw.Draw(mask)
        partic = []
        for j, (x0, amp, cic, fase) in enumerate(correntes):
            for i in range(14):
                u = (t + i / 14 + j * 0.31) % 1.0
                y = Hh - 4 - u * (Hh - 14)
                x = x0 + amp * (0.35 + u) * math.sin(2 * math.pi * (cic * u + t) + fase)
                a = (math.sin(math.pi * u) ** 1.3) * 190
                r = 2.9 + 5.6 * u
                partic.append((a, x, y, r))
        for a, x, y, r in sorted(partic):
            d.ellipse((m * (x - r), m * (y - r), m * (x + r), m * (y + r)), fill=int(a))
        mask = mask.filter(ImageFilter.GaussianBlur(radius=1.5 * m))
        alfa = mask.reduce(ss)
        im = Image.new("RGBA", alfa.size, (255, 246, 232, 0))
        im.putalpha(alfa)
        saida.append(zlib.compress(im.tobytes(), 1))
    return saida, (w, h)


