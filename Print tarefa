)


def _mix(a, b, u):
    if isinstance(a, tuple):
        return tuple(_mix(x, y, u) for x, y in zip(a, b))
    return a + (b - a) * u


def _misturar(pa, pb, u):
    return {k: _mix(pa[k], pb[k], u) for k in pa}


def _suave(u):
    u = max(0.0, min(1.0, u))
    return u * u * u * (u * (u * 6 - 15) + 10)


def _trans(pa, pb, n):
    return [_misturar(pa, pb, _suave(i / (n - 1))) for i in range(n)]


def pose_andar(ph):
    sw = 0.62
    S = sw * DC

    def pe(off, rx):
        q = (ph + off) % 1.0
        if q < sw:
            x, y = S / 2 - S * (q / sw), 0.0
        else:
            u = (q - sw) / (1 - sw)
            x, y = -S / 2 + S * (u * u * (3 - 2 * u)), -9.0 * math.sin(math.pi * u)
        return (rx + x, CHAO + y)

    bob = math.cos(4 * math.pi * ph)
    dy = -1.7 * bob
    p = dict(BASE)
    p.update(
        hip=(115.0, 126.0 + dy * 0.8), sh=(212.0, 126.0 + dy), arch=3.0 + bob,
        head=(251.0, 91.0 + dy * 1.4), rot=1.5 * math.sin(2 * math.pi * ph), look=(1.5, 0.0),
        tail=(-124.0, 58.0, 9.0, 2 * math.pi * ph, 0.0),
        nh=pe(0.0, 111.0), nf=pe(0.25, 218.0), fh=pe(0.5, 111.0), ff=pe(0.75, 218.0),
    )
    return p


def pose_rosnar(ph):
    def s(k):
        return math.sin(2 * math.pi * k * ph)
    tx, ty = 1.1 * s(13), 0.9 * s(11)
    p = dict(BASE)
    p.update(
        hip=(110.0 + tx * 0.6, 152.0 + ty), sh=(206.0 + tx, 160.0 + ty * 0.7), arch=14.0,
        head=(255.0 + tx * 1.4, 140.0 + ty * 1.2), rot=3.0 * s(5), look=(0.0, 2.5),
        eye=0.8, anger=1.0, mouth=0.55 - 0.4 * math.cos(2 * math.pi * 2 * ph), ear=1.0,
        tail=(-112.0, -42.0, 24.0, 2 * math.pi * 2 * ph, 1.0),
        nh=(100.0, CHAO), fh=(118.0, CHAO), nf=(238.0, CHAO), ff=(222.0, CHAO),
    )
    return p


def pose_downdog(ph):
    u = max(0.0, min(1.0, (ph - 0.08) / 0.84))
    boca = 0.95 * math.sin(math.pi * u) ** 1.3
    tt = 0.7 * math.sin(2 * math.pi * 9 * ph)
    p = dict(BASE)
    p.update(
        hip=(98.0, 119.0 + tt * 0.3), sh=(188.0, 164.0 + tt * 0.3), arch=-5.0,
