@dataclass
class Correspondencia:
    x: int
    y: int
    largura: int
    altura: int
    confianca: float
    monitor: int
    metodo: str = "template-cor"
    escala: float = 1.0
    angulo: float | None = None

    @property
    def centro(self) -> tuple[int, int]:
        return self.x + self.largura // 2, self.y + self.altura // 2


def carregar_template(caminho: Path) -> np.ndarray:
    imagem = cv2.imread(str(caminho), cv2.IMREAD_COLOR)
    if imagem is None or imagem.size == 0:
        raise ValueError(f"Não foi possível abrir o alvo: {caminho}")
    return imagem


def _capturar_monitores(monitor_origem: int, restringir_monitor: bool) -> list[tuple[int, dict, np.ndarray]]:
    """Captura uma vez cada monitor usado nesta busca."""
    capturas: list[tuple[int, dict, np.ndarray]] = []
    with mss.MSS() as capturador:
        monitores = capturador.monitors[1:]
        if not monitores:
            return capturas
        if restringir_monitor and 1 <= monitor_origem <= len(monitores):
            candidatos = [(monitor_origem, monitores[monitor_origem - 1])]
        else:
            candidatos = list(enumerate(monitores, start=1))
        for indice, monitor in candidatos:
            bgra = np.asarray(capturador.grab(monitor))
            capturas.append((indice, monitor, cv2.cvtColor(bgra, cv2.COLOR_BGRA2BGR)))
    return capturas


def _score_cor_dominante(template: np.ndarray, frame: np.ndarray, indice: int,
                         monitor: dict) -> Correspondencia | None:
    """Compara componentes de cor em Lab para templates quase uniformes."""
    altura_t, largura_t = template.shape[:2]
    pixels = template.reshape(-1, 3).astype(np.float32)
    cor_media = np.median(pixels, axis=0)
    distancia = np.linalg.norm(pixels - cor_media, axis=1)
    if float(np.percentile(distancia, 90)) > 24.0:
        return None
    template_lab = cv2.cvtColor(np.uint8([[cor_media]]), cv2.COLOR_BGR2LAB)[0, 0].astype(np.float32)
    frame_lab = cv2.cvtColor(frame, cv2.COLOR_BGR2LAB).astype(np.float32)
    delta = np.linalg.norm(frame_lab - template_lab, axis=2)
    tolerancia = max(12.0, min(28.0, float(np.percentile(distancia, 90)) + 14.0))
    mascara = np.uint8(delta <= tolerancia)
    n, rotulos, estatisticas, centros = cv2.connectedComponentsWithStats(mascara, connectivity=8)
    area_t = max(1, largura_t * altura_t)
    melhor: Correspondencia | None = None
    proporcao_t = largura_t / max(1, altura_t)
    for i in range(1, n):
        x, y, largura, altura, area = map(int, estatisticas[i])
        if area < area_t * 0.20 or area > area_t * 4.2:
            continue
        proporcao = largura / max(1, altura)
        erro_prop = abs(np.log(max(0.01, proporcao / proporcao_t)))
        if erro_prop > 0.75:
            continue
        escala = np.sqrt(max(1, area) / area_t)
        escala = min(2.0, max(0.5, escala))
        roi = frame[y:y + altura, x:x + largura]
        lab = cv2.cvtColor(roi, cv2.COLOR_BGR2LAB).astype(np.float32)
        cor_local = np.median(lab.reshape(-1, 3), axis=0)
        erro_cor = float(np.linalg.norm(cor_local - template_lab))
        similaridade_cor = max(0.0, 1.0 - erro_cor / (tolerancia * 1.75))
        similaridade_forma = max(0.0, 1.0 - erro_prop / 0.75)
        similaridade_tamanho = max(0.0, 1.0 - abs(np.log(max(0.01, escala))) / np.log(2.0))
        score = 0.62 * similaridade_cor + 0.23 * similaridade_forma + 0.15 * similaridade_tamanho
        candidato = Correspondencia(
            int(monitor["left"] + x), int(monitor["top"] + y), largura, altura,
            float(min(0.99, score)), indice, metodo="cor-dominante", escala=float(escala),
        )
        if melhor is None or candidato.confianca > melhor.confianca:
            melhor = candidato
    return melhor


def _candidatos_template(template: np.ndarray, frame: np.ndarray, indice: int,
                         monitor: dict) -> Correspondencia | None:
    melhor: Correspondencia | None = None
    altura_original, largura_original = template.shape[:2]
    for escala in (0.50, 0.60, 0.70, 0.80, 0.90, 1.0, 1.10, 1.20, 1.35, 1.50, 1.70, 2.0):
        largura_t = max(1, round(largura_original * escala))
        altura_t = max(1, round(altura_original * escala))
        if altura_t > frame.shape[0] or largura_t > frame.shape[1]:
            continue
        if largura_t == largura_original and altura_t == altura_original:
            temp = template
        else:
            interp = cv2.INTER_AREA if escala < 1 else cv2.INTER_CUBIC
            temp = cv2.resize(template, (largura_t, altura_t), interpolation=interp)
        variancia = float(np.mean(np.var(temp.astype(np.float32), axis=(0, 1))))
        if variancia < 4.0:
            resultado = cv2.matchTemplate(frame, temp, cv2.TM_SQDIFF_NORMED)
            minimo, _, local, _ = cv2.minMaxLoc(resultado)
            score = max(0.0, min(1.0, 1.0 - float(minimo)))
            metodo = "sqdiff-cor"
        else:
            resultado = cv2.matchTemplate(frame, temp, cv2.TM_CCORR_NORMED)
            _, valor, _, local = cv2.minMaxLoc(resultado)
            score = float(max(0.0, min(1.0, valor)))
            metodo = "template-cor"
        candidato = Correspondencia(
            int(monitor["left"] + local[0]), int(monitor["top"] + local[1]),
            largura_t, altura_t, score, indice, metodo=metodo, escala=float(escala),
        )
        if melhor is None or candidato.confianca > melhor.confianca:
            melhor = candidato
    return melhor


def buscar_melhor_uma_vez(
    template: np.ndarray,
    monitor_origem: int = 0,
    restringir_monitor: bool = False,
 ) -> Correspondencia | None:
    melhor: Correspondencia | None = None
    for indice, monitor, frame in _capturar_monitores(monitor_origem, restringir_monitor):
        flat = _score_cor_dominante(template, frame, indice, monitor)
        texturizado = _candidatos_template(template, frame, indice, monitor)
        for candidato in (flat, texturizado):
            if candidato is not None and (melhor is None or candidato.confianca > melhor.confianca):
                melhor = candidato
    return melhor


def buscar_uma_vez(
    template: np.ndarray,
    confianca_minima: float,
    monitor_origem: int = 0,
    restringir_monitor: bool = False,
) -> Correspondencia | None:
    melhor = buscar_melhor_uma_vez(template, monitor_origem, restringir_monitor)
    return melhor if melhor and melhor.confianca >= confianca_minima else None


def localizar(
    caminho: Path,
    confianca_minima: float = 0.85,
    tentativas: int = 5,
    intervalo_ms: int = 400,
    monitor_origem: int = 0,
    restringir_monitor: bool = False,
    cancelado: Callable[[], bool] | None = None,
    ao_tentar: Callable[[int, float | None], None] | None = None,
) -> Correspondencia | None:
    """Repete a busca sem bloquear a UI; cada tentativa pode ser cancelada."""
    template = carregar_template(caminho)
    total = max(1, tentativas)
    for tentativa in range(1, total + 1):
        if cancelado and cancelado():
            return None
        melhor = buscar_melhor_uma_vez(template, monitor_origem, restringir_monitor)
        achado = melhor if melhor and melhor.confianca >= confianca_minima else None
        if ao_tentar:
            ao_tentar(tentativa, melhor.confianca if melhor else None)
        if achado:
            return achado
        if tentativa < total:
            fim = time.monotonic() + max(0, intervalo_ms) / 1000
            while time.monotonic() < fim:
                if cancelado and cancelado():
                    return None
                time.sleep(min(0.05, max(0, fim - time.monotonic())))
    return None


# ==================== motor/acoes.py ====================

def guardar_segredo(nome: str, valor: str) -> None:
    """Guarda no Credential Manager do Windows; recusa backend em texto puro."""
    if sys.platform != "win32":
        raise RuntimeError("O cofre integrado requer Windows Credential Manager.")
    try:
        import keyring
    except ImportError as erro:
        raise RuntimeError("Instale keyring para usar o cofre de credenciais.") from erro
    backend = keyring.get_keyring()
    if "winvault" not in backend.__class__.__name__.casefold():
        raise RuntimeError("O backend seguro do Windows Credential Manager não está ativo.")
    keyring.set_password("Cerbero", nome, valor)


def obter_segredo(nome: str) -> str:
    if sys.platform != "win32":
        raise RuntimeError("O cofre integrado requer Windows Credential Manager.")
    try:
        import keyring
    except ImportError as erro:
        raise RuntimeError("Instale keyring para usar o cofre de credenciais.") from erro
    backend = keyring.get_keyring()
    if "winvault" not in backend.__class__.__name__.casefold():
        raise RuntimeError("O backend seguro do Windows Credential Manager não está ativo.")
    valor = keyring.get_password("Cerbero", nome)
    if valor is None:
        raise KeyError(f"segredo ausente no cofre: {nome}")
    return valor


def validar_destino_segredo(destinos: list[str]) -> tuple[bool, str]:
    """Só libera segredo quando o título ativo contém destino autorizado."""
    permitidos = [item.strip().casefold() for item in destinos if item.strip()]
    if not permitidos:
        return False, "configure ao menos um título/domínio permitido para o passo sensível"
    try:
        import pygetwindow
        titulo = (pygetwindow.getActiveWindowTitle() or "").casefold()
    except Exception:
        return False, "não foi possível verificar a janela ativa; segredo bloqueado"
    if not titulo:
        return False, "janela ativa sem título verificável; segredo bloqueado"
    if not any(destino in titulo for destino in permitidos):
        return False, "janela ativa não corresponde aos destinos permitidos; segredo bloqueado"
    return True, titulo


ACOES = ("clique", "clique_duplo", "clique_direito", "digitar", "tecla", "scroll", "esperar", "pausar_ate_encontrar")
ROTULOS_ACAO = {"clique":"Clique","clique_duplo":"Clique duplo","clique_direito":"Clique com botão direito","digitar":"Digitar","tecla":"Pressionar tecla","scroll":"Rolar tela","esperar":"Esperar","pausar_ate_encontrar":"Aguardar até localizar"}
CODIGOS_ACAO = {rotulo: codigo for codigo, rotulo in ROTULOS_ACAO.items()}


def executar_acao(acao, posicao, texto, tecla, scroll_pixels, digitar_humano):
    controle = pyautogui
    if acao in {"clique", "clique_duplo", "clique_direito"}:
        if posicao is None:
            raise ValueError("A ação de mouse precisa de um alvo localizado.")
        controle.moveTo(*posicao, duration=0)
        if acao == "clique":
            controle.click()
        elif acao == "clique_duplo":
            controle.doubleClick()
        else:
            controle.rightClick()
    elif acao == "digitar":
        if posicao is None:
            raise ValueError("A ação de digitar precisa de um campo localizado.")
        controle.click(*posicao)
        time.sleep(0.08)
        if digitar_humano:
            for indice, caractere in enumerate(texto):
                controle.write(caractere)
                if indice < len(texto) - 1:
                    time.sleep(random.uniform(0.04, 0.12))
        else:
            controle.write(texto)
    elif acao == "tecla":
        teclas = [parte.strip() for parte in tecla.lower().replace("+", " ").split() if parte.strip()]
        if not teclas:
            raise ValueError("Informe uma tecla ou combinação, como ctrl+s.")
        controle.press(teclas[0]) if len(teclas) == 1 else controle.hotkey(*teclas)
    elif acao == "scroll":
        if posicao is None:
            raise ValueError("A ação de rolar a tela precisa de um alvo localizado.")
        controle.moveTo(*posicao, duration=0)
        controle.scroll(round(int(scroll_pixels) / 40))
    elif acao not in {"esperar", "pausar_ate_encontrar"}:
        raise ValueError(f"Ação desconhecida: {acao}")
    return False


# ==================== motor/executor.py ====================

class Executor:
    def __init__(
        self,
        raiz: Path,
        eventos: queue.Queue,
        restringir_monitor: bool = False,
    ):
        self.raiz = raiz
        self.eventos = eventos
        self.restringir_monitor = restringir_monitor
        self.parar_evento = threading.Event()
        self.thread: threading.Thread | None = None
        self.inicio: float | None = None
        self.ciclo = 0
        self._listener = None

    @property
    def ativo(self) -> bool:
        return bool(self.thread and self.thread.is_alive())

    def iniciar(self, perfil: Perfil, modo: str, ciclos: int) -> bool:
        if self.ativo:
            return False
        if not perfil.alvos:
            self.eventos.put(("log", "erro", "fila vazia; adicione um alvo antes de executar"))
            return False
        self.parar_evento.clear()
        self.ciclo = 0
        self.thread = threading.Thread(
            target=self._rodar, args=(perfil, modo, max(1, ciclos)),
            name="cerbero-executor", daemon=True,
        )
        self.thread.start()
        return True

    def parar(self, motivo: str = "parada solicitada") -> None:
        if self.ativo:
            self.eventos.put(("log", "info", motivo))
            self.parar_evento.set()

    def _registrar_hotkey(self) -> None:
        try:
            from pynput import keyboard

            def ao_pressionar(tecla):
                if tecla in (keyboard.Key.esc, keyboard.Key.f12):
                    self.parar("botão de pânico acionado")

            self._listener = keyboard.Listener(on_press=ao_pressionar)
            self._listener.daemon = True
            self._listener.start()
            return
        except Exception:
            self._listener = None
        try:
            import keyboard

            keyboard.add_hotkey("esc", lambda: self.parar("botão de pânico acionado"))
            keyboard.add_hotkey("f12", lambda: self.parar("botão de pânico acionado"))
            self._listener = "keyboard"
        except Exception as erro:
            self.eventos.put(("log", "erro", f"hotkey global indisponível: {erro}"))

    def _remover_hotkey(self) -> None:
        if self._listener == "keyboard":
            try:
                import keyboard

                keyboard.unhook_all_hotkeys()
            except Exception:
                pass
        elif self._listener is not None:
            try:
                self._listener.stop()
            except Exception:
                pass
        self._listener = None

    def _log(self, nivel: str, mensagem: str) -> None:
        self.eventos.put(("log", nivel, mensagem))

    def _localizar(self, alvo, infinito: bool = False) -> Correspondencia | None:
        caminho = self.raiz / alvo.arquivo
        if not caminho.is_file():
            self._log("erro", f"alvo ausente: {alvo.nome}")
            return None
        melhor_score: float | None = None
        while not self.parar_evento.is_set():
            def registrar_tentativa(numero: int, confianca: float | None) -> None:
                nonlocal melhor_score
                if confianca is not None:
                    melhor_score = confianca if melhor_score is None else max(melhor_score, confianca)
                total = max(1, int(alvo.tentativas))
                if not infinito and (confianca is None or confianca < float(alvo.confianca)) and numero < total:
                    score = "n/d" if confianca is None else f"{confianca:.2f}"
                    self._log("info", f"alvo {alvo.nome} abaixo da precisão mínima · melhor resultado {score} · tentando novamente ({numero}/{total})")

            resultado = localizar(
                caminho,
                confianca_minima=float(alvo.confianca),
                tentativas=1 if infinito else int(alvo.tentativas),
                intervalo_ms=int(alvo.intervalo_tentativa_ms),
                monitor_origem=int(alvo.monitor_origem),
                restringir_monitor=self.restringir_monitor,
                cancelado=self.parar_evento.is_set,
                ao_tentar=registrar_tentativa,
            )
            if resultado:
                return resultado
            if not infinito or self.parar_evento.is_set():
                if not self.parar_evento.is_set():
                    score = "n/d" if melhor_score is None else f"{melhor_score:.2f}"
                    self._log("erro", f"alvo {alvo.nome} não localizado · melhor precisão {score} · mínimo {float(alvo.confianca):.2f}")
                return None
            self.eventos.put(("status", "aguardando", self.ciclo, self.inicio))
            self.parar_evento.wait(max(0, int(alvo.intervalo_tentativa_ms)) / 1000)
        return None

    def _esperar_cooperativo(self, milissegundos: int) -> None:
        self.parar_evento.wait(max(0, milissegundos) / 1000)

    def _executar_alvo(self, alvo, indice: int) -> None:
        if self.parar_evento.is_set():
            return
        estado_inicial = "aguardando" if alvo.acao == "esperar" else "vendo"
        self.eventos.put(("status", estado_inicial, self.ciclo, self.inicio))
        posicao: tuple[int, int] | None = None
        correspondencia = None
        if alvo.acao == "pausar_ate_encontrar":
            self._log("info", f"aguardando alvo {indice:02d}: {alvo.nome}")
            correspondencia = self._localizar(alvo, infinito=True)
        elif alvo.acao not in {"esperar"}:
            self._log("info", f"buscando alvo {indice:02d}: {alvo.nome}")
            correspondencia = self._localizar(alvo)
            if correspondencia is None:
                if not self.parar_evento.is_set():
                    self._log("erro", f"alvo {indice:02d} não localizado; seguindo para o próximo")
                return
            posicao = correspondencia.centro
            self._log(
                "ok",
                f"alvo {indice:02d} localizado em ({posicao[0]}, {posicao[1]}) · "
                f"confiança {correspondencia.confianca:.2f}",
            )
        if self.parar_evento.is_set():
            return
        if alvo.acao != "esperar":
            self.eventos.put(("status", "agindo", self.ciclo, self.inicio))
        texto_exec = alvo.texto
        try:
            if alvo.acao == "esperar":
                self._log("info", f"esperando {alvo.delay_ms} ms")
                self._esperar_cooperativo(alvo.delay_ms)
            elif alvo.acao == "pausar_ate_encontrar":
                if correspondencia:
                    self._log("ok", f"alvo {indice:02d} encontrado; fila liberada")
                else:
                    return
            else:
                if alvo.acao == "digitar":
                    referencia = _PADRAO_SEGREDO.fullmatch(texto_exec.strip())
                    if alvo.sensivel or referencia:
                        if not referencia:
                            self._log("erro", f"passo sensível {alvo.nome} bloqueado: o perfil não contém uma referência ao cofre")
                            return
                        liberado, motivo = validar_destino_segredo(alvo.destinos_permitidos)
                        if not liberado:
                            self._log("erro", f"segredo bloqueado em {alvo.nome}: {motivo}")
                            return
                        try:
                            texto_exec = obter_segredo(referencia.group(1))
                        except (KeyError, RuntimeError) as erro:
                            self._log("erro", f"segredo indisponível em {alvo.nome}: {erro}")
                            return
                executar_acao(
                    alvo.acao, posicao, texto_exec, alvo.tecla,
                    alvo.scroll_pixels, alvo.digitar_humano,
                )
                self._log("ok", f"{ROTULOS_ACAO.get(alvo.acao, alvo.acao)} concluído · {alvo.nome}")
        except Exception as erro:
            if erro.__class__.__name__ == "FailSafeException":
                self.parar_evento.set()
                self._log("erro", "proteção do mouse acionada; execução interrompida")
            else:
                self._log("erro", f"falha em {alvo.nome}: {erro}")
        if alvo.acao != "esperar":
            self._esperar_cooperativo(alvo.delay_ms)

    def _rodar(self, perfil: Perfil, modo: str, ciclos: int) -> None:
        self.inicio = time.monotonic()
        self._registrar_hotkey()
        self.eventos.put(("status", "vendo", self.ciclo, self.inicio))
        self._log("info", f"execução iniciada · perfil {perfil.nome} · ESC/F12 para parar")
        volta = 0
        try:
            while not self.parar_evento.is_set():
                volta += 1
                self.ciclo = volta
                self.eventos.put(("status", "vendo", self.ciclo, self.inicio))
                for indice, alvo in enumerate(perfil.alvos, start=1):
                    if self.parar_evento.is_set():
                        break
                    self._executar_alvo(alvo, indice)
                if modo == "simples" or (modo == "ciclos" and volta >= ciclos):
                    break
        except Exception as erro:
            self._log("erro", f"execução interrompida: {erro}")
        finally:
            self._remover_hotkey()
            estado_final = "parado" if self.parar_evento.is_set() else "ocioso"
            self.eventos.put(("status", estado_final, self.ciclo, self.inicio))
            self._log("info", "execução encerrada")


