def gerar_quadros_gato(k, ao_progresso=None):
    """Renderiza todos os quadros (comprimidos) — roda numa thread, sem tocar no Tk."""
    clips = montar_clips()
    total = sum(len(v) for v in clips.values())
    feitos = 0
    saida = {}
    for nome, poses in clips.items():
        quadros = []
        for pose in poses:
            im = desenhar_gato(pose, k)
            quadros.append(zlib.compress(im.tobytes(), 1))
            feitos += 1
            if ao_progresso:
                ao_progresso(feitos / total)
        saida[nome] = quadros
    return saida


