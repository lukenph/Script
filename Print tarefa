def executar_selftest() -> int:
    resultados = []
    try:
        cor_alvo = (30, 145, 235)
        template = np.full((12, 12, 3), cor_alvo, dtype=np.uint8)
        quadro = np.full((180, 260, 3), (32, 32, 32), dtype=np.uint8)
        for x, y in ((20, 25), (110, 55), (205, 120), (60, 135)):
            quadro[y:y + 12, x:x + 12] = cor_alvo
        monitor = {"left": 0, "top": 0, "width": 260, "height": 180}
        plano = _score_cor_dominante(template, quadro, 1, monitor)
        resultados.append(("quadrado liso", bool(plano and plano.confianca >= .55)))
        ruido = quadro.copy()
        rng = np.random.default_rng(7)
        ruido[:] = np.clip(ruido.astype(np.int16) + rng.integers(-5, 6, ruido.shape), 0, 255).astype(np.uint8)
        plano = _score_cor_dominante(template, ruido, 1, monitor)
        resultados.append(("variação de cor", bool(plano and plano.confianca >= .55)))
        ok, jpg = cv2.imencode(".jpg", quadro, [cv2.IMWRITE_JPEG_QUALITY, 40])
        img = cv2.imdecode(jpg, cv2.IMREAD_COLOR) if ok else None
        plano = _score_cor_dominante(template, img, 1, monitor) if img is not None else None
        resultados.append(("JPEG", bool(plano and plano.confianca >= .55)))
        scaled = cv2.resize(template, (18, 18), interpolation=cv2.INTER_NEAREST)
        frame = np.full((120, 160, 3), (25, 25, 25), dtype=np.uint8)
        frame[43:61, 71:89] = scaled
        plano = _candidatos_template(template, frame, 1, {"left": 0, "top": 0, "width": 160, "height": 120})
        resultados.append(("multiescala", bool(plano and plano.confianca >= .55)))
    except Exception as erro:
        print(f"FALHOU · selftest interno · {erro}")
        return 1
    for nome, ok in resultados:
        print(f"{'PASSOU' if ok else 'FALHOU'} · {nome}")
    return 0 if all(ok for _, ok in resultados) else 1


def main() -> None:
    import argparse
    parser = argparse.ArgumentParser(description="Hunter Cat · automatizador visual")
    parser.add_argument("--selftest", action="store_true")
    args = parser.parse_args()
    if args.selftest:
        raise SystemExit(executar_selftest())
    pyautogui.FAILSAFE = True
    pyautogui.PAUSE = .05
    app = JanelaHunterCat()
    app.mainloop()


if __name__ == "__main__":
    main()
