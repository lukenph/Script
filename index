    const editableElements = document.querySelectorAll(".editable");
    const toggleEditBtn = document.getElementById("toggleEditBtn");
    const langEN = document.getElementById("langEN");
    const langPT = document.getElementById("langPT");

    function currentText(key) {
        return siteData?.texts?.[currentLanguage]?.[key]
            ?? DEFAULTS[currentLanguage]?.[key]
            ?? "";
    }

    function renderLanguage() {
        document.documentElement.lang = currentLanguage === "pt" ? "pt-BR" : "en";

        editableElements.forEach((el) => {
            const key = el.dataset.key;
            // textContent is deliberate: saved data can never become HTML.
            el.textContent = currentText(key);
        });

        document.querySelectorAll("[data-ui]").forEach((el) => {
            const key = el.dataset.ui;
            if (UI[currentLanguage][key]) {
                el.textContent = UI[currentLanguage][key];
            }
        });

        langEN.classList.toggle("active", currentLanguage === "en");
        langPT.classList.toggle("active", currentLanguage === "pt");

        if (toggleEditBtn) {
            toggleEditBtn.textContent = editMode ? UI[currentLanguage].done : UI[currentLanguage].edit;
        }
    }

    function collectCurrentTexts() {
        const texts = {};
        editableElements.forEach((el) => {
            texts[el.dataset.key] = el.textContent;
        });
        return texts;
    }

    async function api(path, options = {}) {
        const response = await fetch(path, {
            credentials: "same-origin",
            ...options
        });

        let payload = null;
        try {
            payload = await response.json();
        } catch (_) {
            // Empty/non-JSON response.
        }

        if (!response.ok) {
            throw new Error(payload?.error || `HTTP ${response.status}`);
        }

        return payload;
    }

    async function loadSite() {
        try {
            const payload = await api("/api/site");
            siteData = payload;
            renderLanguage();
            await loadAllMedia();
        } catch (error) {
            console.error("Não foi possível carregar o site:", error);
            renderLanguage();
        }
    }

    async function saveAllTextForCurrentLanguage() {
        const textMap = collectCurrentTexts();

        await api("/api/site/texts", {
            method: "PUT",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({
                language: currentLanguage,
                texts: textMap
            })
        });

        siteData.texts[currentLanguage] = textMap;
    }

    function enableEditing() {
        if (!authenticated) return;

        editMode = true;
        document.body.classList.add("edit-mode");

        editableElements.forEach((el) => {
            el.contentEditable = "true";
            el.spellcheck = true;
        });

        renderLanguage();
    }

    async function disableEditing() {
        try {
            await saveAllTextForCurrentLanguage();

            editMode = false;
            document.body.classList.remove("edit-mode");

            editableElements.forEach((el) => {
                el.contentEditable = "false";
            });

            renderLanguage();
        } catch (error) {
            console.error(error);
            alert(UI[currentLanguage].saveError);
        }
    }

    toggleEditBtn.addEventListener("click", async () => {
        if (!authenticated) return;

        if (editMode) {
            await disableEditing();
        } else {
            enableEditing();
        }
    });

    editableElements.forEach((el) => {
        el.addEventListener("paste", (event) => {
            event.preventDefault();

            const text = (event.clipboardData || window.clipboardData)
                .getData("text/plain");

            // Pasting as text, never as HTML.
            document.execCommand("insertText", false, text);
        });
    });

    async function setLanguage(language) {
        if (!["en", "pt"].includes(language) || language === currentLanguage) return;

        if (editMode) {
            await disableEditing();
            if (editMode) return;
        }

        currentLanguage = language;
        localStorage.setItem("portfolio_language", currentLanguage);
        renderLanguage();
    }

    langEN.addEventListener("click", () => setLanguage("en"));
    langPT.addEventListener("click", () => setLanguage("pt"));

    async function uploadMedia(file, kind, slot) {
        if (!authenticated) {
            throw new Error("Unauthorized");
        }

        const form = new FormData();
        form.append("file", file);
        form.append("kind", kind);
        form.append("slot", slot);

        return api("/api/media", {
            method: "POST",
            body: form
        });
    }

    function setupImageInput(inputId, imageId, emptyId, slot) {
        const input = document.getElementById(inputId);
        const image = document.getElementById(imageId);
        const empty = document.getElementById(emptyId);

        input.addEventListener("change", async () => {
            const file = input.files[0];
            if (!file || !authenticated) return;

            try {
                const result = await uploadMedia(file, "image", slot);
                renderImage(imageId, emptyId, result.url);
            } catch (error) {
                console.error(error);
                alert(UI[currentLanguage].uploadImageError);
            } finally {
                input.value = "";
            }
        });
    }

    function setupVideoInput() {
        const input = document.getElementById("videoInput");
        const video = document.getElementById("showreelVideo");
        const empty = document.getElementById("videoEmpty");

        input.addEventListener("change", async () => {
            const file = input.files[0];
            if (!file || !authenticated) return;

            try {
                const result = await uploadMedia(file, "video", "showreelVideo");
                renderVideo(result.url);
            } catch (error) {
                console.error(error);
                alert(UI[currentLanguage].uploadVideoError);
            } finally {
                input.value = "";
            }
        });
    }

    function renderImage(imageId, emptyId, url) {
        const image = document.getElementById(imageId);
        const empty = document.getElementById(emptyId);

        if (url) {
            image.src = url;
            image.style.display = "block";
            empty.style.display = "none";
        } else {
            image.removeAttribute("src");
            image.style.display = "none";
            empty.style.display = "grid";
        }
    }

    function renderVideo(url) {
        const video = document.getElementById("showreelVideo");
        const empty = document.getElementById("videoEmpty");

        if (url) {
            video.src = url;
            video.style.display = "block";
            empty.style.display = "none";
        } else {
            video.removeAttribute("src");
            video.style.display = "none";
            empty.style.display = "block";
        }
    }

    async function loadAllMedia() {
        renderImage("mainImage", "mainImageEmpty", siteData?.media?.mainImage);
        renderImage("projectImage1", "projectEmpty1", siteData?.media?.projectImage1);
        renderImage("projectImage2", "projectEmpty2", siteData?.media?.projectImage2);
        renderImage("projectImage3", "projectEmpty3", siteData?.media?.projectImage3);
        renderImage("projectImage4", "projectEmpty4", siteData?.media?.projectImage4);
        renderImage("projectImage5", "projectEmpty5", siteData?.media?.projectImage5);
        renderImage("projectImage6", "projectEmpty6", siteData?.media?.projectImage6);
        renderImage("projectImage7", "projectEmpty7", siteData?.media?.projectImage7);
        renderVideo(siteData?.media?.showreelVideo);
    }

