@dataclass
class Alvo:
    id: str
    nome: str
    arquivo: str
    ordem: int = 0
    in_queue: bool = True
    acao: str = "clique"
    texto: str = ""
    delay_ms: int = 450
    confianca: float = 0.85
    tentativas: int = 5
    intervalo_tentativa_ms: int = 400
    monitor_origem: int = 0
    digitar_humano: bool = False
    scroll_pixels: int = 500
    tecla: str = "enter"
    arquivos: list[str] = field(default_factory=list)
    sensivel: bool = False
    destinos_permitidos: list[str] = field(default_factory=list)

    @classmethod
    def de_dict(cls, dados: dict[str, Any]) -> "Alvo":
        campos = cls.__dataclass_fields__
        valores = {k: v for k, v in dados.items() if k in campos}
        if not valores.get("arquivos") and valores.get("arquivo"):
            valores["arquivos"] = [valores["arquivo"]]
        return cls(**valores)

    def para_dict(self) -> dict[str, Any]:
        return asdict(self)


@dataclass
class Perfil:
    nome: str
    alvos: list[Alvo] = field(default_factory=list)
    modo: str = "simples"
    ciclos: int = 1

    @classmethod
    def de_dict(cls, dados: dict[str, Any]) -> "Perfil":
        return cls(
            nome=str(dados.get("nome", "perfil")),
            alvos=[Alvo.de_dict(a) for a in dados.get("alvos", [])],
            modo=str(dados.get("modo", "simples")),
            ciclos=max(1, int(dados.get("ciclos", 1))),
        )

    def para_dict(self) -> dict[str, Any]:
        return {
            "nome": self.nome,
            "alvos": [a.para_dict() for a in self.alvos],
            "modo": self.modo,
            "ciclos": self.ciclos,
        }


